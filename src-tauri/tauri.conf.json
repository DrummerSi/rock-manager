{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rock Manager",
  "version": "0.1.0",
  "identifier": "com.rockmanager.recreation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Rock Manager", "width": 1024, "height": 768, "minWidth": 800, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico", "icons/icon.png"] }
}
