property countdown
global gUseful

on new me
  return me
end

on init me
  gUseful.setSoundSystem(#xtra)
  CPTest()
  gUseful.frameTimer.addObject(me)
  cpstart()
  countdown = 59
end

on startMovie me
end

on timeTick me
  if countdown > 0 then
    countdown = countdown - 1
  end if
end

on kill me
  cpx()
  gUseful.frameTimer.deleteObject(me)
  return 0
end
