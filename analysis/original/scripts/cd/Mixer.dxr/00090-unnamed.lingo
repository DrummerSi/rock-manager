on whosPlaysInstrumentBest argMusicians_r, argInstrument
  maxVal = 0
  maxMusician_r = 0
  repeat with musician_r in argMusicians_r
    tmp = rgetProp(musician_r.InstrumentalSkills, argInstrument)
    if tmp > maxVal then
      maxVal = tmp
      maxMusician_r = musician_r
    end if
  end repeat
  return maxMusician_r
end
