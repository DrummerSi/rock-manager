property m_ctrlVals, m_ctrlRanges, m_fxName, m_textMemberName

on new me
  m_fxName = #delay
  m_ctrlRanges = [#Mix: [#range: [#min: 0.0, #max: 1.0]], #time: [#range: [#min: 0.0, #max: 1.0]], #Decay: [#range: [#min: 0.0, #max: 0.5]]]
  m_textMemberName = "NoteText"
  m_ctrlVals = [#Active: 0, #Mix: 0.5, #time: 0.59999999999999998, #Decay: 0.29999999999999999]
  return me
end

on kill me
  return 0
end

on displayDelayTime me, argStr
  if member(m_textMemberName).text <> argStr then
    member(m_textMemberName).text = argStr
  end if
end

on convDelayTime me, argVal
  lst = ["32", "16T", "16", "8T", "8", "4T", "4"]
  if stringp(argVal) then
    Pos = lst.getPos(argVal)
    if Pos = 0 then
      return 0
    end if
    return float(Pos - 1) / (lst.count - 1)
  else
    Nr = integer(argVal * (lst.count - 1)) + 1
    return lst[Nr]
  end if
end

on getGFX me
  defs = [#BG: [#type: #Pic, #Pic: "background_mixer_effect_delay01", #loc: point(0, 0)], #Active: [#type: #button, #loc: point(60, 36)], #Mix: [#type: #Knob, #loc: point(161, 0)], #time: [#type: #Knob, #loc: point(205, 0)], #TimeDisplay: [#type: #Pic, #Pic: m_textMemberName, #loc: point(171, 5)], #Decay: [#type: #Knob, #loc: point(270, 0)]]
  return defs
end

on openedDlg me, argDlg
end

on Report me, argObj, argWhat, argOption
  ID = argWhat
  m_ctrlVals[ID] = argOption
  if ID = #time then
    me.displayDelayTime(me.convDelayTime(argOption))
    itemObj = argObj.m_dlg.getItem(#TimeDisplay)
    itemObj.setOneProp(#Pic, member("NoteText"))
  end if
end

on getGfxVal me, argID
  if argID = #time then
    me.displayDelayTime(me.convDelayTime())
  end if
  val = m_ctrlVals[argID]
  return val
end

on getCtrlSetting me, argID
  val = m_ctrlVals[argID]
  tmpRangeInfo = m_ctrlRanges.getaProp(argID)
  if listp(tmpRangeInfo) then
    rng = tmpRangeInfo[#range]
    diff = rng[#max] - rng[#min]
    val = (val * diff) + rng[#min]
    if argID = #time then
      val = me.convDelayTime(val)
    end if
  end if
  return val
end

on getSettings me
  lst = [:]
  repeat with n = 1 to m_ctrlVals.count
    ID = m_ctrlVals.getPropAt(n)
    lst.addProp(ID, me.getCtrlSetting(ID))
  end repeat
  return lst
end
