property m_itemObj, m_firstFrame, m_frameNr, m_numFrames, m_reportObj, ID

on new me, argItemObj, argOptions
  if voidp(argOptions) then
    argOptions = [:]
  end if
  m_itemObj = argItemObj
  m_itemObj.mouseObj.setCursor(#DragH)
  m_reportObj = argOptions[#ReportTo]
  if voidp(argOptions[#firstFrame]) then
    argOptions[#firstFrame] = "small_ratt01_0000"
  end if
  m_firstFrame = member(argOptions[#firstFrame]).number
  ID = argOptions[#ID]
  m_frameNr = 0
  m_numFrames = argOptions[#numFrames]
  if voidp(m_numFrames) then
    m_numFrames = 64
  end if
  if voidp(argOptions[#val]) then
    argOptions[#val] = 0.0
  end if
  me.setVal(argOptions[#val])
  return me
end

on kill me
  m_itemObj = 0
  m_reportObj = 0
  return 0
end

on mouse me, argObj, argWhat
  if argWhat = #DownOnOther then
    exit
  end if
  if argWhat = #down then
  else
    if argWhat = #stillDown then
      diff = argObj.deltaMove[1]
      m_frameNr = (float(diff) / 2) + m_frameNr
      me.renderKnob()
      if objectp(m_reportObj) then
        if m_reportObj.handler(#Report) then
          m_reportObj.Report(me, #KnobVal, me.getVal())
        else
          pott("No report handler!")
        end if
      end if
    else
      if argWhat = #click then
      end if
    end if
  end if
end

on setVal me, argVal
  m_frameNr = argVal * (m_numFrames - 1)
  me.renderKnob()
end

on getVal me
  return float(m_frameNr) / (m_numFrames - 1)
end

on renderKnob me
  if integer(m_frameNr) >= m_numFrames then
    m_frameNr = m_numFrames - 1
  else
    if integer(m_frameNr) < 0 then
      m_frameNr = 0
    end if
  end if
  m_itemObj.setOneProp(#Pic, member(m_firstFrame + integer(m_frameNr)))
end
