on xxxfixPalettes
  Prefix = "Actor"
  maxNr = 32
  repeat with tmpCast = 1 to maxNr
    tmpCastFileName = Prefix & convItoS(tmpCast, 2)
    tmpInfo = CPgetActorInfo(tmpCastFileName)
    if tmpInfo.count then
      tmpChanged = 0
      repeat with n = 1 to the number of castMembers of castLib "Actor"
        memb = member(n, "Actor")
        if memb.type = #bitmap then
          if memb.paletteRef <> #systemWin then
            memb.paletteRef = #systemWin
            tmpChanged = 1
          end if
        end if
      end repeat
      if tmpChanged then
        castLib("Actor").save(the moviePath & tmpCastFileName & ".cst")
        put tmpCastFileName, "Saved!"
      else
        put tmpCastFileName, "no change"
      end if
      next repeat
    end if
    put tmpCastFileName, "error loading!"
  end repeat
end
