property waitForWhat, m_go, m_do

on beginSprite me
  waitForWhat = #talkFinished
end

on Report me, argObj, argWhat
  if argWhat = waitForWhat then
    if m_do = #FreezeSpeaker then
      argObj.freeze()
    else
      if m_do = #RenderSpeaker then
        argObj.render()
      end if
    end if
    if m_go = #NextFrame then
      go(the frame + 1)
    else
      if m_go = #NextMarker then
        go(marker(1))
      end if
    end if
  end if
end

on exitFrame me
  go(the frame)
end

on getPropertyDescriptionList me
  return [#m_do: [#comment: "Do", #format: #symbol, #default: #RenderSpeaker, #range: [#nothing, #RenderSpeaker, #FreezeSpeaker]], #m_go: [#comment: "Go", #format: #symbol, #default: #NextFrame, #range: [#NextFrame, #NextMarker]]]
end
