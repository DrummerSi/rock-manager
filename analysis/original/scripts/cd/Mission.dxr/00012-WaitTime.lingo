property NumSecs, doWhat, waitUntil

on beginSprite me
  waitUntil = (NumSecs * 1000) + the milliSeconds
end

on exitFrame me
  if the milliSeconds > waitUntil then
    go(the frame + 1)
    exit
  end if
  go(the frame)
end

on getPropertyDescriptionList me
  return [#NumSecs: [#comment: "Wait num seconds", #format: #float, #default: 1.0], #doWhat: [#comment: "Do", #format: #symbol, #default: #GoNextFrame, #range: [#GoNextFrame]]]
end
