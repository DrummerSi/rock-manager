property m_freeCasts

on new me
  m_freeCasts = []
  repeat with n = 1 to the number of castLibs
    if offset("Actor", castLib(n).name) = 1 then
      m_freeCasts.add(castLib(n).name)
    end if
  end repeat
  return me
end

on kill me
  return 0
end

on getCast me
  if m_freeCasts.count = 0 then
    return 0
  end if
  tmp = m_freeCasts[1]
  m_freeCasts.deleteAt(1)
  return tmp
end

on returnCast me, argObj, argCast
  m_freeCasts.add(argCast)
end
