property OKToTick, m_mouseObj
global gUseful, gDir

on beginSprite me
  OKToTick = 0
  if the runMode = "Author" then
  end if
end

on enterFrame me
  if OKToTick then
    if objectp(gUseful) then
      loop(gUseful)
    end if
  end if
end

on exitFrame me
  OKToTick = 1
  preloadCastsOfFrame(the frame + 1)
end

on idle me
  gUseful.idle()
end

on endSprite me
  if objectp(m_mouseObj) then
    m_mouseObj = m_mouseObj.kill()
  end if
end

on mouse me, argObj, argWhat
  if argWhat = #click then
    go(the frame + 1)
  end if
end
