property m_soundName, m_mood, m_person

on beginSprite me
  repeat with tmpSPNr = 1 to 100
    tmp = sendSprite(tmpSPNr, #getPerson)
    if tmp = m_person then
      sendSprite(tmpSPNr, #Speak, m_soundName, m_mood)
      exit repeat
    end if
  end repeat
end

on getPropertyDescriptionList me
  return [#m_person: [#comment: "Person", #format: #string, #default: EMPTY], #m_soundName: [#comment: "Sound name", #format: #string, #default: EMPTY], #m_mood: [#comment: "Mood", #format: #symbol, #default: #Same, #range: [#Same, #normal, #Happy, #Angry]]]
end
