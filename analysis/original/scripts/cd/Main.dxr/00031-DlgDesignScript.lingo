property ancestor, m_selectInCategory, m_place_r, m_album_r, m_price, m_image, m_alreadyGotSleeve
global gDir, gRock

on new me, argOptions
  ID = argOptions[#ID]
  argOptions.setaProp(#ReportTo, me)
  argOptions.setaProp(#child, me)
  m_album_r = gRock.m_context.getFocus(#album)
  if objectp(m_album_r) then
    m_selectInCategory = m_album_r.DesignSettings.duplicate()
  else
    m_selectInCategory = [:]
  end if
  m_alreadyGotSleeve = m_selectInCategory.count > 0
  dialog_r = gRock.m_classManager.getObjByIDAndClass(#DlgDesign, #Dialog)
  if m_alreadyGotSleeve then
    dialog_r.dataMemberName = "DlgDesignSleeveDoneData"
  else
    dialog_r.dataMemberName = "DlgDesignData"
  end if
  argOptions[#DlgInfoObj] = dialog_r
  m_place_r = gRock.m_classManager.getObjByIDAndClass(ID, #place)
  ancestor = script("DlgRockAncestorScript").new(argOptions)
  cats = [#DCDesignBG, #DCDesignArtist, #DCDesignFX, #DCDesignFont]
  gotContractForCurrentRecord = 0
  if gRock.m_player.CPContractor <> #none then
    if objectp(m_album_r) then
      if m_album_r.SignedToRecord <> #none then
        gotContractForCurrentRecord = 1
      end if
    end if
  end if
  if gotContractForCurrentRecord = 0 then
    itemObj = ancestor.m_objDlg.getItem(#Button3)
    if objectp(itemObj) then
      itemObj.send(#dimButton, 1)
    end if
  end if
  if not m_alreadyGotSleeve then
    tmpChooserWidth = 210
    orgItem = ancestor.m_objDlg.getItem(#Choose1)
    tmpItem = orgItem.dialogObj.getItemByPath([#Chooser, #text])
    tmpR = tmpItem.getOneProp(#inOffsetRect)
    tmpR[3] = tmpChooserWidth
    tmpItem.setOneProp(#inOffsetRect, tmpR)
    orgItemProps = orgItem.copyProps()
    repeat with n = 1 to cats.count
      catID = cats[n]
      cat_r = gRock.m_classManager.getObjByIDAndClass(catID, #DesignCategory)
      if objectp(cat_r) then
        if n = 1 then
          newItem = orgItem
        else
          orgItemProps[#ID] = symbol("Choose" & string(n))
          orgItemProps[#inOffsetRect] = orgItemProps[#inOffsetRect] + [0, 60, 0, 0]
          newItem = ancestor.m_objDlg.addItem(orgItemProps)
          tmpItem = newItem.dialogObj.getItemByPath([#Chooser, #text])
          tmpR = tmpItem.getOneProp(#inOffsetRect)
          tmpR[3] = tmpChooserWidth
          tmpItem.setOneProp(#inOffsetRect, tmpR)
        end if
        tmpObj = newItem.dialogObj.getItemByPath([#Head, #icon])
        if objectp(tmpObj) then
          tmpObj.setOneProp(#Pic, cat_r.Gfx)
        end if
        tmpObj = newItem.dialogObj.getItemByPath([#Head, #Info])
        if objectp(tmpObj) then
          tmpObj.setOneProp(#editData, cat_r.name)
        end if
        if n <> 1 then
          objsBtn = newItem.dialogObj.getItemsByType(#button)
          repeat with obj in objsBtn
            obj.scriptInstanceList.addAt(1, me)
          end repeat
        end if
        if not voidp(m_selectInCategory[catID]) then
          me.setChooser(catID, 0)
          next repeat
        end if
        me.setChooser(catID, 1)
      end if
    end repeat
  end if
  itemObj = ancestor.m_objDlg.getItem(#ButtonOK)
  if objectp(itemObj) then
    itemObj.send(#dimButton, 1)
  end if
  me.makeComposite()
  ancestor.render()
  gRock.m_eventCardsManager.allowEventCardsWithProp(#ShowInDesign, 1, 1)
  return me
end

on kill me
  gRock.m_eventCardsManager.allowEventCardsWithProp(#ShowInDesign, 0, 0)
  m_image = 0
  ancestor.kill()
  return 0
end

on GetSPNeed me
  return ancestor.GetSPNeed() + 1
end

on Report me, argObj, argWhat, argOption
  if argWhat = #BookedOK then
    eventToBook_r = argOption
    album_r = gRock.m_context.getFocus(#album)
    if not objectp(album_r) then
      album_r = gRock.m_classManager.createObj(#album)
      album_r.ID = gRock.m_classManager.genUniqueID(album_r)
    end if
    album_r.ReleaseDate = eventToBook_r.StartDate
    eventToBook_r.albumID = album_r.ID
    me.designDone()
    argObj.kill()
    me.kill()
  else
    if argWhat = #BookedCancel then
      argObj.kill()
    end if
  end if
end

on mouse me, argObj, argWhat, argOption
  if objectp(argOption) then
    if argWhat = #click then
      ID = argOption.getOneProp(#ID)
      IDStr = string(ID)
      if offset("Arrow", IDStr) then
        obj = argOption
        if objectp(obj) then
          overIDs = obj.masterObj.getOverIDs()
          cnt = overIDs.count()
          if cnt >= 2 then
            belongingToID = overIDs[1]
            tmp = string(belongingToID)
            if offset("Choose", tmp) then
              delete ID.char[1..6]
              categoryNr = value(tmp)
            else
              exit
            end if
            categoryID = m_selectInCategory.getPropAt(categoryNr)
            tmpDir = (2 * (ID = #ArrowDown)) - 1
            if me.setChooser(categoryID, tmpDir) then
              itemObj = ancestor.m_objDlg.getItem(#ButtonOK)
              itemObj.send(#dimButton, 0)
              me.makeComposite()
            end if
          end if
        end if
      else
        if ID = #ButtonOK then
          if m_alreadyGotSleeve then
            ancestor.mouse(argObj, argWhat, argOption)
            exit
          else
            if not objectp(m_album_r) then
              ecardID = #ECOCDesignNoAlbum
            end if
            if not symbolp(ecardID) then
              if objectp(m_album_r) then
                if m_album_r.SignedToRecord = #none then
                  if gRock.m_player.CPContractor = #none then
                    ecardID = #ECOCDesignNoAlbum
                  else
                    ecardID = #ECOCDesignNoAlbumPlayDemo
                  end if
                end if
                if not symbolp(ecardID) then
                  if m_album_r.ReleaseDate > 0 then
                    ecardID = #ECOCDesignTwo
                  end if
                end if
              end if
            end if
            if not symbolp(ecardID) then
              if gRock.m_player.hasThisMoney(m_price) = 0 then
                ecardID = #ECOCNoMoneyWarning
              end if
            end if
            tmpCreatedSleeve = 0
            repeat with n = 1 to m_selectInCategory.count
              if me.getSelectedElementNr(m_selectInCategory.getPropAt(n)) > 1 then
                tmpCreatedSleeve = 1
                exit repeat
              end if
            end repeat
            if symbolp(ecardID) and not rOKCheatPass() then
              gRock.m_eventCardsManager.tryNewShowEventCard(ecardID, [#prio: 0])
              exit
            end if
            eventToBook_r = gRock.m_classManager.createObj(#AlbumRelease)
            newID = gRock.m_classManager.genUniqueID(eventToBook_r)
            rsetProp(eventToBook_r, #ID, newID)
            lst = rgetProp(eventToBook_r, #neededIDs)
            lst.add(#NotOnTour)
            eventToBook_r.setDates(6 + gRock.m_date.getDateInt(), 1)
            eventToBook_r.name = gRock.m_languageManager.getStr(#szidScheduleRelease)
            if tmpCreatedSleeve then
              picImg = member("tmpCD_frame").image.duplicate()
              picImg.copyPixels(m_image, rect(2, 2, 72, 72), m_image.rect)
            else
              picImg = member("image_nodesign01_small01").image
            end if
            infoImg = rFormatText([#szidScheduleRelease, #szidScheduleReleaseInfo], "LiveBookFormatting", [#shadow: 1])
            dlg = gDir.m_objDialogsMaster.openDialog(#Book, [#UseDlgID: #DlgRecordReleaseBook, #bookOptions: [#PicImage: picImg, #InfoImage: infoImg, #EventToBook: eventToBook_r, #AutoClose: 0]])
            dlg.m_objReportTo = me
            exit
          end if
        else
          if ID = #Button3 then
            gDir.m_objDialogsMaster.openDialog(#Merchandise)
            exit
          end if
        end if
        ancestor.mouse(argObj, argWhat, argOption)
      end if
    end if
  end if
end

on getSelectedElementNr me, argCatID
  currentSelectedID = m_selectInCategory.getaProp(argCatID)
  if voidp(currentSelectedID) or (currentSelectedID = 0) then
    return VOID
  end if
  cat_r = gRock.m_classManager.getObjByIDAndClass(argCatID, #DesignCategory)
  return cat_r.elements.getPos(currentSelectedID)
end

on getSelectedElementObj me, argCatID
  currentSelectedID = m_selectInCategory.getaProp(argCatID)
  if voidp(currentSelectedID) or (currentSelectedID = 0) then
    return VOID
  end if
  element_r = gRock.m_classManager.getObjByIDAndClass(currentSelectedID, #DesignElement)
  return element_r
end

on setChooser me, argCatID, argDirection
  currentSelectedID = m_selectInCategory.getaProp(argCatID)
  cat_r = gRock.m_classManager.getObjByIDAndClass(argCatID, #DesignCategory)
  if voidp(currentSelectedID) then
    currentSelectedID = cat_r.elements[1]
    argDirection = 0
  end if
  tmpPos = cat_r.elements.getPos(currentSelectedID)
  if tmpPos = 0 then
    return 0
  end if
  tmpPos = rDlgCheckUpDownArrows(VOID, tmpPos + argDirection, cat_r.elements.count)
  elementID = cat_r.elements[tmpPos]
  m_selectInCategory.setaProp(argCatID, elementID)
  element_r = gRock.m_classManager.getObjByIDAndClass(elementID, #DesignElement)
  itemPos = m_selectInCategory.findPos(argCatID)
  changeDlgItem = ancestor.m_objDlg.getItem(symbol("Choose" & string(itemPos)))
  if objectp(changeDlgItem) then
    textObj = changeDlgItem.dialogObj.getItem(#text)
    if objectp(textObj) then
      textObj.setOneProp(#editData, element_r.name & " " & rCurrency(element_r.price, 0, 1))
    end if
  end if
  return 1
end

on makeComposite me
  m_price = 0
  repeat with n = 1 to m_selectInCategory.count()
    elementID = m_selectInCategory[n]
    element_r = gRock.m_classManager.getObjByIDAndClass(elementID, #DesignElement)
    if objectp(element_r) then
      m_price = m_price + element_r.price
    end if
  end repeat
  pott(m_price, "m_price")
  m_image = makeAlbumCover(m_selectInCategory)
  obj = ancestor.m_objDlg.getItem(#Pic)
  obj.setOneProp(#Pic, m_image)
end

on designDone me
  gRock.m_player.transactMoney(-m_price, [#Design])
  element_r = me.getSelectedElementObj(#DCDesignArtist)
  musiciansExpo = [#DEDArtists01: [#Other: 1.0], #DEDArtists02: [#Vocals: 2.0, #Other: 1.0], #DEDArtists03: [#Vocals: 2.0, #Other: 0.0], #DEDArtists04: [#Other: 0.0]]
  musiciansExpo = musiciansExpo.getaProp(element_r.ID)
  band_r = gRock.m_context.getFocus(#Band)
  musicians_r = band_r.getMusicianObjs()
  quality = m_album_r.quality
  repeat with n = 1 to m_selectInCategory.count
    catID = m_selectInCategory.getPropAt(n)
    if catID = #DCDesignArtist then
      next repeat
    end if
    element_r = me.getSelectedElementObj(catID)
    if objectp(element_r) then
      quality = quality + element_r.quality
    end if
  end repeat
  weightedCharisma = [:]
  repeat with mus_r in musicians_r
    Expo = musiciansExpo.getaProp(mus_r.NowPlaying)
    if voidp(Expo) then
      Expo = musiciansExpo.getaProp(#Other)
    end if
    weightedCharisma.addProp(Expo, rgetProp(mus_r, #Charisma))
  end repeat
  avg = calcAverage(weightedCharisma)
  quality = quality + (0.10000000000000001 * (avg - 0.5))
  if quality < 0 then
    quality = 0.0
  else
    if quality > 1 then
      quality = 1.0
    end if
  end if
  m_album_r.quality = quality
  weightedMusicStyle = [:]
  repeat with mus_r in musicians_r
    Expo = musiciansExpo.getaProp(mus_r.NowPlaying)
    if voidp(Expo) then
      Expo = musiciansExpo.getaProp(#Other)
    end if
    weightedMusicStyle.addProp(Expo, mus_r.MusicStyle)
  end repeat
  rCalcObjsAverage(m_album_r.ImageStyle, weightedMusicStyle)
  repeat with n = 1 to m_selectInCategory.count
    catID = m_selectInCategory.getPropAt(n)
    if catID = #DCDesignArtist then
      next repeat
    end if
    element_r = me.getSelectedElementObj(catID)
    if objectp(element_r) then
      gRock.m_classManager.add(m_album_r.ImageStyle, element_r.Style)
    end if
  end repeat
  tmpProps = gRock.m_classManager.getPropsInClass(m_album_r.ImageStyle.className)
  repeat with n = 1 to tmpProps.count
    tmpProp = tmpProps.getPropAt(n)
    tmpVal = rgetProp(m_album_r.ImageStyle, tmpProp)
    if tmpVal > 1 then
      rsetProp(m_album_r.ImageStyle, tmpProp, 1.0)
      next repeat
    end if
    if tmpVal < 0 then
      rsetProp(m_album_r.ImageStyle, tmpProp, 0.0)
    end if
  end repeat
  tuneDebugObject(m_album_r.ImageStyle, "Album ImageStyle")
  singerID = #RMC
  otherMusicianIDs = []
  repeat with mus_r in musicians_r
    if mus_r.NowPlaying = #Vocals then
      singerID = mus_r.ID
      next repeat
    end if
    otherMusicianIDs.add(mus_r.ID)
  end repeat
  element_r = me.getSelectedElementObj(#DCDesignArtist)
  if element_r.ID = #DEDArtists01 then
  else
    if element_r.ID = #DEDArtists02 then
      rCreateModifier(#SleeveHappy, singerID, #Mood, 0.10000000000000001, 10)
      repeat with musID in otherMusicianIDs
        rCreateModifier(#SleeveAngry, musID, #Mood, -0.10000000000000001, 10)
      end repeat
    else
      if element_r.ID = #DEDArtists03 then
        rCreateModifier(#SleeveHappy, singerID, #Mood, 0.20000000000000001, 10)
        repeat with musID in otherMusicianIDs
          rCreateModifier(#SleeveAngry, musID, #Mood, -0.20000000000000001, 10)
        end repeat
      else
        if element_r.ID = #DEDArtists04 then
          repeat with mus_r in musicians_r
            rCreateModifier(#SleeveAngry, mus_r.ID, #Mood, -0.10000000000000001, 10)
          end repeat
        end if
      end if
    end if
  end if
  m_album_r.DesignSettings = m_selectInCategory
  gRock.m_msgManager.msg(#AlbumSleeve)
end
