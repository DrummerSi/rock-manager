property m_locOrg, m_locScroll, m_objsBuildings, m_SPbg, m_widthScrollArea, m_objsMouseScroll, m_iScrollDir, m_animObjs, m_sndObj, m_numVisibleBuildings, m_waitingToStartSound, m_active
global gDir, gUseful, gRock

on new me
  m_locScroll = point(0, 0)
  m_objsBuildings = [:]
  BGMember = member("city_background01")
  places = gRock.m_classManager.getObjsWithBaseClass(#place)
  BGMember = member("city_background01")
  m_SPbg = sprite(gDir.m_spriteList[#ScrollBG])
  m_SPbg.member = BGMember
  m_locOrg = point(400, 340)
  m_SPbg.loc = m_locOrg
  hotspots = member("HotspotsField").text.value
  if not listp(hotspots) then
    hotspots = [:]
  end if
  SPNum = gDir.m_spriteList[#Buildings]
  repeat with placeObj in places
    tmpRect = hotspots.getaProp(placeObj.ID)
    if listp(tmpRect) then
      tmpRect = tmpRect - rect(BGMember.regPoint, BGMember.regPoint)
    end if
    obj = script("BuildingScript").new(me, placeObj.ID, SPNum, placeObj, tmpRect)
    m_objsBuildings.addProp(placeObj.ID, obj)
    SPNum = SPNum + obj.GetSPNeed()
  end repeat
  m_numVisibleBuildings = 0
  repeat with obj in m_objsBuildings
    obj.show()
    if obj.getIsVisible() then
      m_numVisibleBuildings = m_numVisibleBuildings + 1
    end if
  end repeat
  m_widthScrollArea = 100
  gUseful.frameTimer.addObject(me)
  tmpAnims = ["car01_0017", "crane01_0022", "radar01_0007", "radiotower01_0000", "tvtower01_0000", "water01_0000", "car02_0005"]
  m_animObjs = []
  repeat with animName in tmpAnims
    obj = script("CityAnimScript").new(0, animName, SPNum)
    m_animObjs.add(obj)
    SPNum = SPNum + 1
  end repeat
  m_objsMouseScroll = []
  m_objsMouseScroll.add(script("MouseObject").new(me, rect(-200, 0, m_widthScrollArea, 600), [#ID: #ScrollLeft, #layer: 9, #PassButton: 1, #cursorRoll: #NoClick]))
  m_objsMouseScroll.add(script("MouseObject").new(me, rect(800 - m_widthScrollArea, 0, 1000, 600), [#ID: #ScrollRight, #layer: 9, #PassButton: 1, #cursorRoll: #NoClick]))
  m_iScrollDir = 0
  m_waitingToStartSound = 4
  m_active = 1
  return me
end

on getPlaceGfxObjByID me, argID
  return m_objsBuildings.getaProp(argID)
end

on kill me
  if objectp(m_sndObj) then
    m_sndObj = m_sndObj.kill()
  end if
  repeat with obj in m_animObjs
    obj.kill()
  end repeat
  m_animObjs = []
  repeat with obj in m_objsBuildings
    obj.kill()
  end repeat
  m_objsBuildings = [:]
  repeat with obj in m_objsMouseScroll
    obj.kill()
  end repeat
  m_objsMouseScroll = []
  gUseful.frameTimer.deleteObject(me)
  return 0
end

on redraw me
  loc = m_locOrg + m_locScroll
  m_SPbg.loc = loc
  m_numVisibleBuildings = 0
  repeat with obj in m_objsBuildings
    obj.timeTick()
    if obj.getIsVisible() then
      m_numVisibleBuildings = m_numVisibleBuildings + 1
    end if
  end repeat
  repeat with obj in m_animObjs
    obj.timeTick()
    obj.redraw(loc)
  end repeat
end

on mouse me, argObj, argWhat
  if (argObj.ID = #ScrollLeft) or (argObj.ID = #ScrollRight) then
    if argWhat = #enter then
      if argObj.ID = #ScrollLeft then
        m_iScrollDir = -1
      else
        m_iScrollDir = 1
      end if
    else
      if argWhat = #Leave then
        m_iScrollDir = 0
      end if
    end if
  end if
end

on timeTick me
  if not m_active then
    exit
  end if
  if m_waitingToStartSound > 0 then
    m_waitingToStartSound = m_waitingToStartSound - 1
    if m_waitingToStartSound = 0 then
      me.startSound()
    end if
  end if
  if m_iScrollDir <> 0 then
    tmp = the mouseLoc
    if tmp[1] < m_widthScrollArea then
      tmpDiff = m_widthScrollArea - tmp[1]
    else
      if tmp[1] > (800 - m_widthScrollArea) then
        tmpDiff = 800 - m_widthScrollArea - tmp[1]
      end if
    end if
    if integerp(tmpDiff) then
      tmpFract = tmpDiff / float(m_widthScrollArea)
      if abs(tmpFract) > 1.0 then
        tmpFract = 1.0 * getSign(tmpFract)
      end if
      m_locScroll[1] = (tmpFract * 20.0) + m_locScroll[1]
      if abs(m_locScroll[1]) > ((1200 + 50 - 800) / 2) then
        m_locScroll[1] = (1200 + 50 - 800) / 2 * getSign(m_locScroll[1])
      end if
    end if
  end if
  me.redraw()
end

on pause me, argIsTRUE
  m_active = not argIsTRUE
  if argIsTRUE then
    if objectp(m_sndObj) then
      m_sndObj = m_sndObj.kill()
    end if
  else
    m_waitingToStartSound = 6
  end if
  m_iScrollDir = 0
  repeat with obj in m_animObjs
    obj.activate(not argIsTRUE)
  end repeat
  repeat with obj in m_objsBuildings
    obj.pause(argIsTRUE)
  end repeat
end

on startSound me
  if objectp(m_sndObj) then
    m_sndObj = m_sndObj.kill()
  end if
  partVisible = float(m_numVisibleBuildings) / m_objsBuildings.count
  tmpSndSuffix = comesBeforeValInList(partVisible, [0.20000000000000001: 1, 0.40000000000000002: 2, 0.59999999999999998: 3, 0.80000000000000004: 4, 2.0: 5])
  tmpSnd = "CityAmbience" & convItoS(tmpSndSuffix, 2)
  tmpSnd = "CityAmbience01"
  if getSystemPref(#CitySound) = #Mute then
    exit
  end if
  m_sndObj = script("SoundScript").new(gRock.m_paths.getPath(#sound) & tmpSnd & gUseful.soundFileExt, [#PlayDirect: 0, #vol: #CityBGVol])
  if objectp(m_sndObj) then
    m_sndObj.setLoop(1)
    m_sndObj.fade(#in, 1000)
    tmpRnd = integer(m_sndObj.getLength(#Secs) * 1000)
    tmpRnd = random(tmpRnd)
    m_sndObj.setPosition(tmpRnd / 1000.0, #Secs)
    m_sndObj.play()
  end if
end
