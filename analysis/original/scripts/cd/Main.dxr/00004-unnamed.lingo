on X
  global gDir, gUseful
  gUseful.mouseObjects.mouseDown(point(280, 60))
  gUseful.mouseObjects.mouseUp(point(280, 60))
end

on xxCreateExpoReview
  global gRock
  expo_r = gRock.m_classManager.createObj(#ExpoReview)
  expo_r.ID = gRock.m_classManager.genUniqueID(expo_r)
  expo_r.ReviewOfClass = #album
  expo_r.ReviewOfID = #album1
  expo_r.Rating = 0.5
  expo_r.quality = 0.5
  expo_r.Intensity = 0.29999999999999999
  expo_r.setDates(gRock.m_date.getDateInt(), 2)
  expo_r.MediaID = #Media01
end

on xxFakeNadiaOver
  rex("EventCard(#ECOCMis4Media01RqNadia, makePropList(#EventCardOptions, makePropList(#DontCloseOnOK, 1)), Û#RMCPernille)")
end

on xxshowTickedObjs
  global gRock
  errObjs = []
  repeat with lst in gRock.m_gameTimer.objectsPerGroup
    repeat with n = 1 to lst.count
      obj = lst[n]
      if rGotHandler(obj, #timeTick) = 0 then
        pott("No timetick!", obj, obj.ID)
        errObjs.add(obj)
      end if
    end repeat
  end repeat
  return errObjs
end
