property ancestor, m_place_r, m_songs_r, m_song_r, m_scroller, m_sequencer, m_waveRenderer, m_snd
global gDir, gRock

on new me, argOptions
  global gUseful
  ID = argOptions[#ID]
  m_place_r = gRock.m_classManager.getObjByID(ID, #player)
  argOptions.setaProp(#ReportTo, me)
  argOptions.setaProp(#child, me)
  dialog_r = gRock.m_classManager.getObjByIDAndClass(#DlgPublish, #Dialog)
  argOptions[#DlgInfoObj] = dialog_r
  ancestor = script("DlgRockAncestorScript").new(argOptions)
  mission_r = gRock.m_context.getFocus(#Mission)
  if mission_r.AvailableSongs.count = 0 then
    m_songs_r = gRock.m_classManager.getObjsOfClass(#Song)
    m_songs_r = m_songs_r.duplicate()
  else
    m_songs_r = []
    repeat with SongID in mission_r.AvailableSongs
      m_songs_r.add(gRock.m_classManager.getObjByIDAndClass(SongID, #Song))
    end repeat
  end if
  repeat with n = m_songs_r.count down to 1
    if m_place_r.Songs.getPos(m_songs_r[n].ID) = 0 then
      m_songs_r.deleteAt(n)
    end if
  end repeat
  repeat with n = m_songs_r.count down to 1
    if gRock.m_player.OwnedSongs.getPos(m_songs_r[n].ID) then
      m_songs_r.deleteAt(n)
    end if
  end repeat
  itemObj = ancestor.m_objDlg.getItemByPath([#ScrollView, #Head1, #Info])
  if objectp(itemObj) then
    itemObj.setOneProp(#editData, rGetStr(#szidSongTitle))
  end if
  itemObj = ancestor.m_objDlg.getItemByPath([#ScrollView, #Head2, #Info])
  if objectp(itemObj) then
    itemObj.setOneProp(#editData, rGetStr(#szidPrice))
  end if
  itemObj = ancestor.m_objDlg.getItemByPath([#ScrollView, #Head3, #Info])
  if objectp(itemObj) then
    itemObj.setOneProp(#editData, rGetStr(#szidRoyalty))
  end if
  allScrollItems = []
  repeat with song_r in m_songs_r
    allScrollItems.add(rDlgCreateScrollItemInfo(song_r, song_r))
  end repeat
  ancestor.m_objDlg.recalc(#DontPaint)
  itemObj = ancestor.m_objDlg.getItemByPath([#ScrollView, #Frame2])
  rct = itemObj.getOnStageRect()
  rct = rct + rect(3, 3, -3, -3)
  m_scroller = script("CPScrollerScript").new(me, ancestor.getSPOverDlg(), allScrollItems, rct, ancestor.m_objDlg.highestMouseLayer)
  gUseful.setSoundSystem(#xtra)
  me.setPlace()
  ancestor.render()
  return me
end

on kill me
  global gUseful
  gUseful.setSoundSystem(#Director)
  if objectp(m_sequencer) then
    m_sequencer = m_sequencer.kill()
  end if
  if objectp(m_scroller) then
    m_scroller = m_scroller.kill()
  end if
  ancestor.kill()
  return 0
end

on Report me, argObj, argWhat, argOption
  if argObj = m_scroller then
    if argWhat = #select then
      song_r = argOption.m_ID
      me.setSong(song_r)
      me.playSong()
    end if
  end if
end

on mouse me, argObj, argWhat, argOption
  if objectp(argOption) then
    if argWhat = #click then
      ID = argOption.getOneProp(#ID)
      IDStr = string(ID)
      if ID = #ButtonOK then
        player_r = gRock.m_classManager.getObjByIDAndClass(#player, #player)
        if player_r.hasThisMoney(m_song_r.PriceModel.BasePrice) = 0 then
          rWarnMoney()
          exit
        end if
        player_r.transactMoney(-m_song_r.PriceModel.BasePrice)
        player_r.OwnedSongs.add(m_song_r.ID)
        gRock.m_context.setFocus(#Song, m_song_r)
        ancestor.mouse(argObj, argWhat, argOption)
      else
        ancestor.mouse(argObj, argWhat, argOption)
      end if
    end if
  end if
end

on setPlace me
  dlgObj = ancestor.m_objDlg
  itemObj = ancestor.m_objDlg.addItem([#ID: #Meter1, #type: #Dialog, #inOffsetRect: rect(90, 10, 0, 0), #rel: [[#Info2, 1], [#Info2, 2], #Auto, #Auto]])
  rNewGenerateMeter(itemObj)
  itemObj = ancestor.m_objDlg.addItem([#ID: #Meter2, #type: #Dialog, #inOffsetRect: rect(90, 27, 0, 0), #rel: [[#Info2, 1], [#Info2, 2], #Auto, #Auto]])
  rNewGenerateMeter(itemObj)
  me.setSong(m_songs_r[1])
  gRock.m_context.setFocus(#Song, m_song_r)
end

on setSong me, argObj
  dlgObj = ancestor.m_objDlg
  m_song_r = argObj
  gRock.m_context.setFocus(#Song, m_song_r, 1)
  itemObj = dlgObj.getItem(#Info)
  itemObj.setOneProp(#Pic, rFormatText([m_song_r.name, #szidDescription, m_song_r.comment], "PublishFormatting"))
  itemObj = ancestor.m_objDlg.getItem(#Meter1)
  itemObj.send(#setMeter, m_song_r.SongType)
  itemObj = ancestor.m_objDlg.getItem(#Meter2)
  itemObj.send(#setMeter, m_song_r.quality)
  itemObj = dlgObj.getItem(#Info2)
  itemObj.setOneProp(#Pic, rFormatText([#szidHitFactor, #szidPrice, rCurrency(m_song_r.PriceModel.BasePrice, 0, 1), #szidQuality, #szidRoyalty, convFloatToPercent(m_song_r.PriceModel.Royalty, 1) & "%"], "Publish2Formatting"))
end

on zzplaySong me
  waitCursor(1)
  if objectp(m_sequencer) then
    m_sequencer = m_sequencer.kill()
  end if
  mix_r = gRock.m_classManager.getObjByIDAndClass(m_song_r.MixerDefault, #MixerSettings)
  if not objectp(mix_r) then
    exit
  end if
  tmpNumCh = mix_r.channels.count
  if tmpNumCh > 2 then
    tmpNumCh = 2
  end if
  if tmpNumCh = 0 then
    exit
  end if
  m_sequencer = script("PlaySequenceScript").new()
  m_sequencer.setPaths([#sound: gRock.m_paths.m_paths[#RenderedMusic]])
  m_sequencer.m_bpm = rgetProp(m_song_r, #BPM)
  m_sequencer.m_numBars = m_song_r.numBars
  m_sequencer.m_beatSignature = m_song_r.TimeSignature
  repeat with n = 1 to tmpNumCh
    chID = mix_r.channels[n]
    ch_r = gRock.m_classManager.getObjByIDAndClass(chID, #channel)
    LoopID = ch_r.LoopID
    loop_r = gRock.m_classManager.getObjByIDAndClass(LoopID, #loop)
    trackObj = script("TrackLoopScript").new(m_sequencer)
    tmpFile = loop_r.file
    tmpOutFile = gRock.m_paths.m_paths[#RenderedMusic] & string(n) & ".wav"
    tmpStr = mixGenFXStr([#in: gRock.m_paths.m_paths[#Sliced] & tmpFile & "\*.*", #Out: tmpOutFile, #tempo: [#Bars: loop_r.numBars, #TimeSig: string(m_song_r.TimeSignature[1]) & "/" & string(m_song_r.TimeSignature[1]), #BPM: m_sequencer.m_bpm]], #dll)
    mixCallRockWave(tmpStr)
    trackObj.setSetting(#file, string(n) & ".wav")
    trackObj.setSetting(#vol, 80)
    m_sequencer.addLoopTrack(trackObj)
  end repeat
  m_sequencer.prepare()
  waitCursor(0)
  m_sequencer.play()
end

on playSong me
  waitCursor(1)
  if objectp(m_sequencer) then
    m_sequencer = m_sequencer.kill()
  end if
  mix_r = gRock.m_classManager.getObjByIDAndClass(m_song_r.MixerDefault, #MixerSettings)
  if not objectp(mix_r) then
    exit
  end if
  tmpNumCh = mix_r.channels.count
  if tmpNumCh > 2 then
    tmpNumCh = 2
  end if
  if tmpNumCh = 0 then
    exit
  end if
  m_sequencer = script("PlaySequenceScript").new()
  m_sequencer.setPaths([#sound: gRock.m_paths.m_paths[#RenderedMusic]])
  m_sequencer.m_bpm = rgetProp(m_song_r, #BPM)
  m_sequencer.m_numBars = m_song_r.numBars
  m_sequencer.m_beatSignature = m_song_r.TimeSignature
  if voidp(m_waveRenderer) then
    m_waveRenderer = script("WaveRenderScript").new()
  end if
  repeat with n = 1 to tmpNumCh
    chID = mix_r.channels[n]
    ch_r = gRock.m_classManager.getObjByIDAndClass(chID, #channel)
    LoopID = ch_r.LoopID
    loop_r = gRock.m_classManager.getObjByIDAndClass(LoopID, #loop)
    m_waveRenderer.queueRendering(n, loop_r.file, [#tempo: [#Bars: loop_r.numBars, #TimeSig: string(m_song_r.TimeSignature[1]) & "/" & string(m_song_r.TimeSignature[1]), #BPM: m_sequencer.m_bpm]])
  end repeat
  m_waveRenderer.m_doWhatWhenDoneList = [#ReportTo: me, #handler: #renderDone]
  m_waveRenderer.renderQueue()
end

on renderDone me
  m_waveRenderer.m_doWhatWhenDoneList = [:]
  repeat with n = 1 to m_waveRenderer.m_rendered.count
    trackObj = script("TrackLoopScript").new(m_sequencer)
    tmpFile = fileExtractName(m_waveRenderer.m_rendered[n])
    trackObj.setSetting(#file, tmpFile)
    trackObj.setSetting(#vol, 80)
    m_sequencer.addLoopTrack(trackObj)
  end repeat
  m_sequencer.prepare()
  waitCursor(0)
  m_sequencer.play()
end

on playSongX me
  fileName = string(m_song_r.ID)
  fileName = fileName.char[fileName.length - 1..fileName.length]
  fileName = fileName & "pre.wav"
  fileName = gRock.m_paths.m_paths[#music] & fileName
  m_snd = sound(1)
  m_snd.playFile(fileName)
end
