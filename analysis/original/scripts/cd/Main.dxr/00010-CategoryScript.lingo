property m_dlg, m_chosenObj, m_action_r, m_actionDlgLoc
global gRock

on new me, argDlgObj
  m_dlg = argDlgObj
  m_actionDlgLoc = VOID
  return me
end

on kill me
  m_action_r = 0
  m_dlg = 0
  m_chosenObj = 0
  return 0
end

on makeObjsOfIDs me, argIDs
  objs_r = []
  repeat with ID in argIDs
    obj_r = gRock.m_classManager.getObjByIDAndClass(ID, #ActionCategory)
    if not objectp(obj_r) then
      obj_r = gRock.m_classManager.getObjByIDAndClass(ID, #Action)
    end if
    if objectp(obj_r) then
      objs_r.add(obj_r)
    end if
  end repeat
  return objs_r
end

on createScrollData me, argIDs, argOverrideType
  if voidp(argIDs) then
    argIDs = m_dlg.m_place_r.Actions
  end if
  if voidp(argOverrideType) then
    argOverrideType = #ActionCategory
  end if
  objs_r = me.makeObjsOfIDs(argIDs)
  itemObj = m_dlg.m_objDlg.getItemByPath([#ScrollView, #Head1, #Info])
  if objectp(itemObj) then
    itemObj.setOneProp(#editData, rGetStr(#szidCategory))
  end if
  allScrollData = []
  repeat with obj_r in objs_r
    if not objectp(obj_r) then
      next repeat
    end if
    tmpDimmed = 0
    if obj_r.className = #ActionCategory then
      if obj_r.Actions.count = 0 then
        tmpDimmed = 1
      else
        if obj_r.PreExecuteThis.length > 0 then
          tmpPreExecuteResult = rExecuteActions(obj_r.PreExecuteThis, [:], obj_r)
          if tmpPreExecuteResult = #DimAction then
            tmpDimmed = 1
          end if
        end if
      end if
    else
      if obj_r.className = #Action then
        if obj_r.PreExecuteThis.length > 0 then
          tmpPreExecuteResult = rExecuteActions(obj_r.PreExecuteThis, [:], obj_r)
          if tmpPreExecuteResult = #DimAction then
            tmpDimmed = 1
          else
            if tmpPreExecuteResult = #HideAction then
              obj_r = 0
            end if
          end if
        end if
      end if
    end if
    if rOKCheatPass() then
      tmpDimmed = 0
    end if
    if objectp(obj_r) then
      allScrollData.add(rDlgCreateScrollItemInfo(obj_r, obj_r, argOverrideType, tmpDimmed))
    end if
  end repeat
  return allScrollData
end

on getIsChosenOfClass me, argClass
  if not objectp(m_chosenObj) then
    return 0
  end if
  if m_chosenObj.className = argClass then
    return 1
  end if
  return 0
end

on checkCategoryReport me, argObj, argWhat, argOption
  global gDir
  if argObj = m_dlg.m_scroller then
    if argWhat = #select then
      obj_r = argOption.m_ID
      m_chosenObj = obj_r
      if obj_r.className = #ActionCategory then
        m_dlg.Report(me, #ActionCategory, m_chosenObj)
        gDir.m_objDialogsMaster.openDialog(#ActionChoose, [#ActionIDs: obj_r.Actions, #icon: obj_r.Gfx, #name: obj_r.name, #loc: m_actionDlgLoc])
      else
        if obj_r.className = #Action then
          m_action_r = obj_r
          newDlg = gDir.m_objDialogsMaster.openDialog(#Confirm, [#InfoImage: m_action_r.name])
          newDlg.m_objReportTo = m_dlg
        end if
      end if
    end if
  else
    if argWhat = #DlgConfirm then
      argObj.kill()
      pott("Confirmed...TODO! Maybe don't want automatic executeActions!")
      if not objectp(m_action_r) then
        exit
      end if
      if argOption <> #ButtonOK then
        exit
      end if
      rPlayerOkayedAction(m_action_r)
    else
      return 0
    end if
  end if
  return 1
end
