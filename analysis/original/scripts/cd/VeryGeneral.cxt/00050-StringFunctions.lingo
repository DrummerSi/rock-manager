on convItoS argInteger, argNrOfTokens
  str = string(argInteger)
  len = str.length
  if len > argNrOfTokens then
    return str.char[1..argNrOfTokens]
  end if
  repeat with n = len to argNrOfTokens - 1
    str = "0" & str
  end repeat
  return str
end

on convValToCurrency argMoney, argThousandSeparator, argDecimalSeparator
  if voidp(argMoney) then
    argMoney = 0
  end if
  tmpSign = getSign(argMoney)
  if tmpSign = -1 then
    argMoney = -argMoney
  end if
  mon = float(argMoney)
  tmpPrec = the floatPrecision
  set the floatPrecision to 2
  if voidp(argThousandSeparator) then
    argThousandSeparator = ","
  end if
  if voidp(argDecimalSeparator) then
    argDecimalSeparator = "."
  end if
  tmpStr = string(mon)
  tmpResultStr = EMPTY
  tmpIntStr = tmpStr.char[1..tmpStr.length - 3]
  numSeparators = (tmpIntStr.length - 1) / 3
  tmpStart = tmpIntStr.length - (numSeparators * 3)
  tmpResultStr = tmpIntStr.char[1..tmpStart]
  repeat with n = 1 to numSeparators
    tmpResultStr = tmpResultStr & argThousandSeparator & tmpIntStr.char[tmpStart + ((n - 1) * 3) + 1..tmpStart + (n * 3)]
  end repeat
  if argDecimalSeparator <> EMPTY then
    tmpResultStr = tmpResultStr & argDecimalSeparator & tmpStr.char[tmpStr.length - 1..tmpStr.length]
  end if
  if tmpSign = -1 then
    tmpResultStr = "-" & tmpResultStr
  end if
  set the floatPrecision to tmpPrec
  return tmpResultStr
end

on convFloatToPercent argFloat, argNumDecimals
  tmp = the floatPrecision
  if voidp(argNumDecimals) then
    argNumDecimals = 0
  end if
  set the floatPrecision to argNumDecimals
  str = string(argFloat * 100)
  set the floatPrecision to tmp
  return str
end

on convItoBits argInteger
  str = EMPTY
  repeat while 1
    if argInteger mod 2 then
      str = "1" & str
    else
      str = "0" & str
    end if
    argInteger = argInteger / 2
    if argInteger = 0 then
      return str
    end if
  end repeat
end

on convBitStoI argStr
  factor = 1
  result = 0
  repeat with n = argStr.length down to 1
    result = result + (factor * (argStr.char[n] = "1"))
    factor = factor * 2
  end repeat
  return result
end

on convItoHexS argVal
  chrs = "0123456789ABCDEF"
  str = EMPTY
  repeat while 1
    X = argVal mod 16
    str = chrs.char[X + 1] & str
    argVal = argVal - X
    argVal = argVal / 16
    if argVal = 0 then
      return str
    end if
  end repeat
end

on convHexSToI argStr
  chrs = "0123456789ABCDEF"
  tot = 0
  multiplier = 1
  repeat with n = argStr.length down to 1
    X = offset(argStr.char[n], chrs) - 1
    tot = tot + (X * multiplier)
    multiplier = multiplier * 16
  end repeat
  return tot
end

on replaceEscapeChars argStr
  insteadOfBackslashStr = "@£%%%%@"
  repeat while 1
    tmpOff = offset("\", argStr)
    if not tmpOff then
      exit repeat
    end if
    nextChar = argStr.char[tmpOff + 1]
    if nextChar = "'" then
      Replace = QUOTE
    else
      if nextChar = "n" then
        Replace = RETURN
      else
        if nextChar = "t" then
          Replace = RETURN
        else
          if nextChar = "\" then
            Replace = insteadOfBackslashStr
          else
            Replace = EMPTY
          end if
        end if
      end if
    end if
    put Replace into argStr.char[tmpOff..tmpOff + 1]
  end repeat
  repeat while 1
    tmpOff = offset(insteadOfBackslashStr, argStr)
    if not tmpOff then
      exit repeat
    end if
    put "\" into argStr.char[tmpOff..tmpOff + the length of insteadOfBackslashStr - 1]
  end repeat
  return argStr
end

on changeChars argSearchStr, argChangeToStr, argOrgStr, argCaseSensitive
  if voidp(argCaseSensitive) then
    argCaseSensitive = 1
  end if
  temporarilyChangedPlaces = []
  repeat while 1
    tmpOff = offset(argSearchStr, argOrgStr)
    if tmpOff then
      isExact = 1
      if argCaseSensitive then
        repeat with n = 1 to argSearchStr.length
          if charToNum(argOrgStr.char[n + tmpOff - 1]) <> charToNum(argSearchStr.char[n]) then
            temporarilyChangedPlaces.add([n + tmpOff - 1, argOrgStr.char[n + tmpOff - 1]])
            put "!" into argSearchStr.char[n + tmpOff - 1]
            isExact = 0
            exit repeat
          end if
        end repeat
      end if
      if isExact then
        put argChangeToStr into argSearchStr.char[tmpOff..tmpOff + the length of argSearchStr - 1]
      end if
      next repeat
    end if
    repeat with Info in temporarilyChangedPlaces
      put Info[2] into argSearchStr.char[Info[1]]
    end repeat
    return argOrgStr
  end repeat
  exit
  assembleString = EMPTY
  if argChangeToStr = EMPTY then
    repeat while 1
      tempOff = offset(argSearchStr, argOrgStr)
      if tempOff then
        assembleString = assembleString & char 1 to tempOff of argOrgStr
        delete char -30000 of assembleString
        delete char 1 to tempOff of argOrgStr
        next repeat
      end if
      assembleString = assembleString & argOrgStr
      exit repeat
    end repeat
  else
    realNum = charToNum(argSearchStr.char[1])
    repeat while 1
      tempOff = offset(argSearchStr, argOrgStr)
      if tempOff then
        assembleString = assembleString & char 1 to tempOff of argOrgStr
        if charToNum(char tempOff of argOrgStr) = realNum then
          put argChangeToStr into char length(assembleString) of assembleString
        end if
        delete char 1 to tempOff of argOrgStr
        next repeat
      end if
      assembleString = assembleString & argOrgStr
      exit repeat
    end repeat
  end if
  return assembleString
end

on getEOL argStr, argStartSearchFromCharNr, argSearchStr
  argSearchStr = RETURN
  repeat with n = argStartSearchFromCharNr to argStr.length
    if argStr.char[n] = argSearchStr then
      return n
    end if
  end repeat
  return 0
end

on offsetBackwards argSearchStr, argInStr, argStartCharNr
  tmpLen = argSearchStr.length
  tmp = argStartCharNr / tmpLen
  repeat with n = 1 to tmp
    tmpStr = argInStr.char[argStartCharNr - (n * tmpLen)..argStartCharNr]
    tmpOff = offset(argSearchStr, argInStr)
    if tmpOff then
      return tmpOff
    end if
  end repeat
  tmpStr = argInStr.char[1..argStartCharNr]
  return offset(argSearchStr, argInStr)
end

on getLineNrWithCharNr argStr, argCharNr
  return the number of lines in argStr.char[1..argCharNr]
  tmpEnd = argStr.length
  repeat with n = argCharNr to argStr.length
    if argStr.char[n] = RETURN then
      tmpEnd = n
      exit repeat
    end if
  end repeat
  tmpStart = 1
  repeat with n = argCharNr down to 1
    if argStr.char[n] = RETURN then
      tmpStart = n + 1
      exit repeat
    end if
  end repeat
end

on wildCardSearch argWildCardStr, argStrList, argReturnType
  if voidp(argReturnType) then
    argReturnType = #Strings
  end if
  tmpParsed = []
  tmpLast = 1
  repeat with n = 1 to argWildCardStr.length
    tmpCh = argWildCardStr.char[n]
    if (tmpCh = "*") or (tmpCh = "?") then
      if tmpLast < n then
        tmpParsed.add(argWildCardStr.char[tmpLast..n - 1])
      end if
      tmpParsed.add(symbol(tmpCh))
      tmpLast = n + 1
    end if
  end repeat
  tmp = argWildCardStr.char[tmpLast..argWildCardStr.length]
  if tmp.length > 0 then
    tmpParsed.add(tmp)
  end if
  tmpRetStrs = []
  tmpRetListPos = []
  repeat with tmpStrNr = 1 to argStrList.count()
    tmpStr = argStrList[tmpStrNr]
    tmpStrCopy = tmpStr
    tmpOK = 1
    tmpMustBeFirst = 1
    repeat with n = 1 to tmpParsed.count()
      tmpComp = tmpParsed[n]
      if symbolp(tmpComp) then
        if tmpComp = #? then
          tmpStrCopy = tmpStrCopy.char[2..tmpStrCopy.length]
          tmpMustBeFirst = 1
        else
          if tmpComp = #* then
            if n = tmpParsed.count() then
              tmpStrCopy = EMPTY
              exit repeat
            end if
            tmpMustBeFirst = 0
          end if
        end if
        next repeat
      end if
      tmpOff = offset(tmpComp, tmpStrCopy)
      if tmpOff and (((tmpOff = 1) and (tmpMustBeFirst = 1)) or (tmpMustBeFirst = 0)) then
        tmpStrCopy = tmpStrCopy.char[tmpOff + tmpComp.length..tmpStrCopy.length]
      else
        tmpOK = 0
        exit repeat
      end if
      tmpMustBeFirst = 1
    end repeat
    if tmpOK and (tmpStrCopy.length = 0) then
      tmpRetStrs.add(tmpStr)
      tmpRetListPos.add(tmpStrNr)
    end if
  end repeat
  if argReturnType = #Strings then
    return tmpRetStrs
  else
    if argReturnType = #Positions then
      return tmpRetListPos
    end if
  end if
  return [#Strings: tmpRetStrs, #Positions: tmpRetListPos]
end

on createListFromIntervalStr argStr
  lst = []
  lastWhat = VOID
  intervalStartVal = VOID
  n = 1
  repeat while 1
    ch = argStr.char[n]
    if ch = " " then
      delete argStr.char[n]
      n = 1
      next repeat
      next repeat
    end if
    if (ch = ",") or (n = argStr.length) then
      tmpLast = n - 1
      if n = argStr.length then
        tmpLast = n
      end if
      lastWhat = #op
      str = argStr.char[1..tmpLast]
      val = value(str)
      if integerp(intervalStartVal) then
        if intervalStartVal > val then
          repeat with m = val to intervalStartVal
            lst.add(m)
          end repeat
        else
          repeat with m = intervalStartVal to val
            lst.add(m)
          end repeat
        end if
        intervalStartVal = VOID
      else
        lst.add(val)
      end if
      if n = argStr.length then
        exit repeat
      end if
      delete argStr.char[1..n]
      n = 1
      next repeat
    end if
    if ch = "-" then
      if voidp(lastWhat) or (lastWhat = #op) then
        n = n + 1
        next repeat
      end if
      lastWhat = #op
      str = argStr.char[1..n - 1]
      intervalStartVal = value(str)
      delete argStr.char[1..n]
      n = 1
      next repeat
    end if
    lastWhat = #val
    n = n + 1
  end repeat
  return lst
end

on trimStringFromChars argStr, argTrimChars
  if not listp(argTrimChars) then
    argTrimChars = [SPACE]
  end if
  repeat with n = argStr.length down to 1
    if argTrimChars.getPos(argStr.char[n]) then
      delete argStr.char[n]
      next repeat
    end if
    exit repeat
  end repeat
  len = argStr.length
  repeat with n = 1 to len
    if argTrimChars.getPos(argStr.char[1]) then
      delete argStr.char[1]
      next repeat
    end if
    exit repeat
  end repeat
  return argStr
end

on reverseString argStr
  str = EMPTY
  repeat with n = argStr.length down to 1
    str = str & argStr.char[n]
  end repeat
  return str
end

on wildcardFreeSearch argWildCard, argStr
  okRange = extractWildcardTextRange(argWildCard)
  if okRange.count = 0 then
    return 1
  end if
  searchStr = argWildCard.char[okRange[1]..okRange[2]]
  off = offset(searchStr, argStr)
  if off = 0 then
    return 0
  end if
  if okRange[2] = argWildCard.length then
    return off
  end if
  nextSearchStr = argWildCard.char[okRange[2] + 1..argWildCard.length]
  nextOff = wildCard2(nextSearchStr, argStr.char[off + searchStr.length..argStr.length])
  if nextOff = 0 then
    return 0
  end if
  nextOff = nextOff - 1
  minTokens = 0
  maxTokens = 0
  repeat with n = okRange[2] + 1 to argWildCard.length
    if argWildCard.char[n] = "?" then
      minTokens = minTokens + 1
      next repeat
    end if
    if argWildCard.char[n] <> "*" then
      exit repeat
      next repeat
    end if
    minTokens = -1
  end repeat
  if maxTokens <> -1 then
    maxTokens = minTokens
  end if
  if (nextOff >= minTokens) and ((nextOff <= maxTokens) or (maxTokens = -1)) then
    return off
  end if
  return wildCard2(argWildCard, argStr.char[off + 1..argStr.length])
end

on extractWildcardTextRange argWildCard
  wildCards = ["*", "?"]
  okRange = []
  repeat with n = 1 to argWildCard.length
    if wildCards.getPos(argWildCard.char[n]) = 0 then
      okRange[1] = n
      okRange[2] = n
      exit repeat
    end if
  end repeat
  if okRange.count = 0 then
    return okRange
  end if
  repeat with n = okRange[1] + 1 to argWildCard.length
    if wildCards.getPos(argWildCard.char[n]) <> 0 then
      okRange[2] = n
      exit repeat
    end if
  end repeat
  okRange[2] = n - 1
  return okRange
end
