property stageRectObj, name, stageRect, stageSize

on new me
  stageRectObj = new(script("RectScript"))
  name = EMPTY
  return me
end

on kill me
  return 0
end

on prepareMovie me
  stageRect = (the stage).rect
  stageRectObj.setRect((the stage).rect)
  name = fileStripName(the movieName)
end

on startMovie me
end

on stopMovie me
end

on getStageSize me
  return stageRectObj.getSize()
end

on getStageMidLoc me
  return stageRectObj.getSize() / 2
end
