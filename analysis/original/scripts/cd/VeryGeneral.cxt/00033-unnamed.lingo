on drawALine argPoint1, argPoint2, argSP
  tmpDiff = argPoint1 - argPoint2
  tmpX = getAt(tmpDiff, 1)
  tmpY = getAt(tmpDiff, 2)
  if tmpX = 0 then
    tmpMemb = "Lineoo"
    setAt(argPoint1, 1, getAt(argPoint1, 1) - 1)
    setAt(argPoint2, 1, getAt(argPoint2, 1) + 1)
  else
    if tmpY = 0 then
      tmpMemb = "Line0"
      setAt(argPoint1, 2, getAt(argPoint1, 2) - 1)
      setAt(argPoint2, 2, getAt(argPoint2, 2) + 1)
    else
      if (tmpX * tmpY) > 0 then
        tmpMemb = "Line-1"
      else
        tmpMemb = "Line1"
      end if
    end if
  end if
  set the member of sprite argSP to member(tmpMemb)
  set the rect of sprite argSP to rect(argPoint1, argPoint2)
end
