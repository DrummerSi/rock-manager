global gUseful

on __debug argPassword, arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8
  if not objectp(gUseful.getaProp(#debug)) then
    exit
  end if
  gUseful.debug.debugOut(argPassword, arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8)
end

on __debugActivate
  if not objectp(gUseful.getaProp(#debug)) then
    exit
  end if
  gUseful.debug.setTimerToZero()
  gUseful.debug.activate(1)
  gUseful.debug.clearBuffer()
end

on __debugFlush
  if not objectp(gUseful.getaProp(#debug)) then
    exit
  end if
  gUseful.debug.flush()
end
