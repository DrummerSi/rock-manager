property keysObj
global gUseful, gShowingMem, gSystem

on new me
  if the machineType = 256 then
    keysObj = new(script("KeysObject"), me, [["F4", [#ID: #quit, #prio: 1]], ["F1", [#ID: #Help, #prio: 1]], ["<", [#ID: #memory, #prio: 1]]])
  else
    keysObj = new(script("KeysObject"), me, [["q", [#ID: #quit, #prio: 1]], ["F1", [#ID: #Help, #prio: 1]], ["Ins", [#ID: #Help, #prio: 1]], ["<", [#ID: #memory, #prio: 1]]])
  end if
  return me
end

on kill me
  if objectp(keysObj) then
    keysObj = kill(keysObj)
  end if
  return 0
end

on key me, argStat, argObj
  if argStat <> #down then
    exit
  end if
  tmpID = argObj.ID
  if (tmpID = #memory) and the shiftDown then
    if gShowingMem then
      gShowingMem = 0
      set the member of sprite 120 to member("Dummy")
    else
      gShowingMem = 1
      tmp = the freeBlock
      member("ShowMemory").text = string(the freeBlock / 1024)
      set the member of sprite 120 to member("ShowMemory")
      set the loc of sprite 120 to point(0, 0)
    end if
  else
    if tmpID = #Help then
      if the machineType = 256 then
        if objectp(gSystem) then
          tmpFileName = gSystem.CDPath & gSystem.helpFile
        else
          tmpFileName = "Havsjakt.hlp"
        end if
        open(tmpFileName, "winhelp.exe")
      else
        if objectp(gSystem) then
          tmpFileName = gSystem.CDPath & gSystem.helpFile
        else
          tmpFileName = "Om Djuphavsjakten"
        end if
        open(tmpFileName, "Skriv text")
      end if
    else
      if tmpID = #quit then
        if the machineType = 256 then
          if the optionDown then
            quitGame(me)
          end if
        else
          if the commandDown then
            quitGame(me)
          end if
        end if
      end if
    end if
  end if
end

on quitGame me
  quit()
end
