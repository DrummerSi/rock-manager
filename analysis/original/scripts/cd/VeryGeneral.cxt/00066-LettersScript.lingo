property allLetters, strangeLettersReplacements

on new me
  allLetters = [:]
  repeat with n = 65 to 90
    allLetters.addProp(n, n + 32)
  end repeat
  allLetters.addProp(138, 154)
  allLetters.addProp(140, 156)
  repeat with n = 192 to 214
    allLetters.addProp(n, n + 32)
  end repeat
  repeat with n = 216 to 223
    allLetters.addProp(n, n + 32)
  end repeat
  strangeLettersReplacements = [:]
  repeat with n = 192 to 198
    strangeLettersReplacements.addProp(n, 65)
    strangeLettersReplacements.addProp(n + 32, 65 + 32)
  end repeat
  strangeLettersReplacements.addProp(199, 67)
  strangeLettersReplacements.addProp(199 + 32, 67 + 32)
  strangeLettersReplacements.addProp(208, 68)
  strangeLettersReplacements.addProp(208 + 32, 68 + 32)
  repeat with n = 200 to 203
    strangeLettersReplacements.addProp(n, 69)
    strangeLettersReplacements.addProp(n + 32, 69 + 32)
  end repeat
  strangeLettersReplacements.addProp(209, 78)
  strangeLettersReplacements.addProp(209 + 32, 78 + 32)
  repeat with n = 204 to 207
    strangeLettersReplacements.addProp(n, 73)
    strangeLettersReplacements.addProp(n + 32, 73 + 32)
  end repeat
  repeat with n = 210 to 216
    strangeLettersReplacements.addProp(n, 79)
    strangeLettersReplacements.addProp(n + 32, 79 + 32)
  end repeat
  repeat with n = 217 to 220
    strangeLettersReplacements.addProp(n, 85)
    strangeLettersReplacements.addProp(n + 32, 85 + 32)
  end repeat
  return me
end

on kill me
  return 0
end

on isLetter me, argAnsi
end

on isUpper me, argAnsi
  tmp = allLetters.getaProp(argAnsi)
  if voidp(tmp) then
    return 0
  else
    return 1
  end if
end

on getOtherCase me, argAnsi
  tmp = allLetters.getaProp(argAnsi)
  if voidp(tmp) then
    tmp = allLetters.getPos(argAnsi)
    if tmp then
      return allLetters.getPropAt(tmp)
    end if
  else
    return tmp
  end if
  return 0
end

on getUpperCase me, argAnsi
  tmp = allLetters.getPos(argAnsi)
  if tmp then
    return allLetters.getPropAt(tmp)
  end if
  return argAnsi
end

on getLowerCase me, argAnsi
  tmp = allLetters.getaProp(argAnsi)
  if tmp then
    return tmp
  end if
  return argAnsi
end
