property nrOfFrames, firstFrame, SP, speedPerFrame, maxVal

on new me, argSP, argMaxVal, argFirstFrame, argNrOfFrames
  maxVal = argMaxVal
  nrOfFrames = argNrOfFrames
  if voidp(nrOfFrames) then
    nrOfFrames = 17
  end if
  nrOfFrames = nrOfFrames - 1
  speedPerFrame = maxVal / nrOfFrames
  firstFrame = getMemberNum(argFirstFrame)
  SP = argSP
  return me
end

on kill me
  return 0
end

on show me, argSpeed
  tmpFrame = nrOfFrames * argSpeed / maxVal
  if tmpFrame > nrOfFrames then
    tmpFrame = nrOfFrames
  end if
  set the member of sprite SP to member(firstFrame + tmpFrame)
end
