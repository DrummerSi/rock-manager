property nrOfSteps, SP, mode, maxVal, maxStretch, orgLoc

on new me, argSP, argMaxVal, argMaxStretch, argMode
  SP = argSP
  maxVal = argMaxVal
  maxStretch = argMaxStretch
  mode = argMode
  orgLoc = the loc of sprite SP
  return me
end

on kill me
  return 0
end

on show me, argVal
  tmpPercent = 1000 * argVal / maxVal
  if abs(tmpPercent) > 1000 then
    tmpPercent = abs(tmpPercent) / tmpPercent * 1000
  end if
  tmp = tmpPercent * maxStretch / 1000
  if tmp < 0 then
    if mode = #X then
      set the loc of sprite SP to orgLoc + point(tmp, 0)
    else
      set the loc of sprite SP to orgLoc + point(0, -tmp)
    end if
  else
    set the loc of sprite SP to orgLoc + point(0, 0)
  end if
  if mode = #X then
    set the width of sprite SP to abs(tmp)
  else
    set the height of sprite SP to abs(tmp)
  end if
end
