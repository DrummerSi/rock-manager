property myRect, reportObject, ID, type, Active, isInside, optionList, downOn, noPassRoll, noPassButton, myLoc, cursorRoll, orgCursRoll, masterObj
global gUseful

on new me, argReportObject, argRectOrSpriteNum, argOptList
  reportObject = argReportObject
  myRect = argRectOrSpriteNum
  noPassRoll = 0
  noPassButton = 1
  if listp(argOptList) then
    ID = getaProp(argOptList, #ID)
    type = getaProp(argOptList, #type)
    layer = getaProp(argOptList, #layer)
    tmp = getaProp(argOptList, #noPassRoll)
    if tmp = 1 then
      noPassRoll = 1
    end if
    tmp = getaProp(argOptList, #PassButton)
    if tmp = 1 then
      noPassRoll = 0
    end if
    cursorRoll = getaProp(argOptList, #cursorRoll)
    orgCursRoll = cursorRoll
    myLoc = getaProp(argOptList, #loc)
    if voidp(myLoc) then
      myLoc = (point(getAt(myRect, 3) - getAt(myRect, 1), getAt(myRect, 4) - getAt(myRect, 2)) / 2) + point(getAt(myRect, 1), getAt(myRect, 2))
    end if
    optionList = argOptList
  else
    optionList = [:]
    layer = 50
  end if
  Active = 1
  isInside = 0
  if voidp(cursorRoll) then
    cursorRoll = #click
  end if
  masterObj = getaProp(optionList, #masterObj)
  if voidp(masterObj) then
    masterObj = gUseful.mouseObjects
  end if
  addObject(masterObj, me, layer)
  return me
end

on kill me
  activate(me, 0)
  deleteObject(masterObj, me)
  return 0
end

on move me, argLoc, argMode
  if argMode = #Relative then
    myLoc = myLoc + argLoc
    myRect = myRect + rect(argLoc, argLoc)
  else
    tmpDiff = argLoc - myLoc
    myRect = myRect + rect(tmpDiff, tmpDiff)
    myLoc = argLoc
  end if
end

on checkDown me, argPoint
  if not Active then
    return 0
  end if
  check(me, argPoint)
  if downOn then
    exit
  end if
  if isInside then
    downOn = 1
    mouse(reportObject, me, #down)
    return noPassButton
  end if
  return 0
end

on checkUp me, argPoint, argOKToClick
  if not Active then
    return 0
  end if
  if not argOKToClick then
    return 0
  end if
  check(me, argPoint)
  if downOn then
    downOn = 0
    if isInside then
      if argOKToClick then
        mouse(reportObject, me, #click)
        return noPassButton
      end if
    else
      mouse(reportObject, me, #UpOutside)
    end if
  else
    if isInside then
      mouse(reportObject, me, #up)
      return noPassButton
    end if
  end if
  return 0
end

on check me, argPoint
  if Active then
    if inside(argPoint, myRect) then
      if symbolp(cursorRoll) then
        cursorChange(masterObj, cursorRoll)
      end if
      if isInside then
        if downOn then
          mouse(reportObject, me, #stillDown)
        end if
      else
        isInside = 1
        mouse(reportObject, me, #enter)
      end if
      return noPassRoll
    else
      if isInside then
        isInside = 0
        mouse(reportObject, me, #Leave)
      end if
    end if
  end if
  return 0
end

on activate me, YesNo
  Active = YesNo
  isInside = 0
end

on getOption me, argProp
  if listp(optionList) then
    return getaProp(optionList, argProp)
  end if
end
