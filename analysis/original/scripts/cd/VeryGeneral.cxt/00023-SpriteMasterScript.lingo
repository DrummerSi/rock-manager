property availableSprites

on new me, argStartSP, argNrOfSprites
  availableSprites = []
  repeat with n = 1 to argNrOfSprites
    add(availableSprites, n + argStartSP - 1)
  end repeat
  return me
end

on kill me
  return 0
end

on getSprite me, argNum
  tmpNum = argNum
  if voidp(tmpNum) then
    tmpNum = 1
  end if
  tmpRealNum = tmpNum
  if tmpRealNum > availableSprites.count() then
    tmpRealNum = availableSprites.count()
  end if
  tmpRetList = []
  repeat with n = 1 to tmpRealNum
    tmpRetList.add(availableSprites[1])
    availableSprites.deleteAt(1)
  end repeat
  repeat with n = tmpRealNum + 1 to tmpNum
    tmpRetList.add(0)
  end repeat
  if voidp(argNum) then
    return tmpRetList[1]
  end if
  return tmpRetList
end

on returnSprite me, argSPList
  if not listp(argSPList) then
    argSPList = [argSPList]
  end if
  repeat with tmpSP in argSPList
    add(availableSprites, tmpSP)
  end repeat
  return 0
end
