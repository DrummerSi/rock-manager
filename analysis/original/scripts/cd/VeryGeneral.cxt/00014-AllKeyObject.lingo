property reportObject, key, pollCode, keyCode, repeatCnt, State, ID, tellMovie, Active
global gUseful

on new me, argReportObject, argKey, argOptions
  reportObject = argReportObject
  reportType()
  options = argOptions
  gUseful.keyObjects.addObject(me)
  Active = 1
  return me
end

on kill me
  Active = 0
  gUseful.keyObjects.deleteObject(me)
  return 0
end

on key me, argState, argPollCode
  if not Active then
    exit
  end if
  reportObject.key(me, argState)
end

on getOption me, argProp
end
