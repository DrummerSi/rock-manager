on getPropFromObjOrAncestor argObj, argProp
  if not objectp(argObj) then
    return VOID
  end if
  tmp = argObj.getaProp(argProp)
  if voidp(tmp) then
    tmp = argObj.getaProp(#ancestor)
    if objectp(tmp) then
      return getPropFromObjOrAncestor(tmp, argProp)
    end if
    return VOID
  else
    return tmp
  end if
end

on setPropInObjOrAncestor argObj, argProp, argVal
  tmp = argObj.getaProp(argProp)
  if voidp(tmp) then
    tmp = argObj.getaProp(#ancestor)
    if objectp(tmp) then
      return setPropInObjOrAncestor(tmp, argProp, argVal)
    else
      if listp(argObj) then
        argObj.setaProp(argProp, argVal)
      end if
    end if
    return 0
  else
    argObj.setaProp(argProp, argVal)
    return 1
  end if
end
