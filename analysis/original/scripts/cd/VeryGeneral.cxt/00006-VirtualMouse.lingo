global gUseful

on virtualMouseUp
  mouseUp(gUseful.mouseObjects, point(the mouseH, the mouseV))
end

on virtualMouseDown
  mouseDown(gUseful.mouseObjects, point(the mouseH, the mouseV))
end

on rightMouseDown
  mouseDown(gUseful.mouseObjects, point(the mouseH, the mouseV))
end

on rightMouseUp
  mouseUp(gUseful.mouseObjects, point(the mouseH, the mouseV))
end

on virtualKeyDown
  keyDown(gUseful.keyObjects)
end

on virtualKeyUp
  keyUp(gUseful.keyObjects)
end

on keyDown
end

on keyUp
end
