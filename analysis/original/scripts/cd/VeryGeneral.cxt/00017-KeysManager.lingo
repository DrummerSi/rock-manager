property addObjectList, deleteObjectList, objects, busyRepeating, dismissingKeys, keyConvertTable, keysDown, keyProp, Active, forceKeysDown, gotXtra
global gUseful

on new me
  addObjectList = [:]
  deleteObjectList = []
  objects = [:]
  sort(objects)
  busyRepeating = 0
  dismissingKeys = 0
  if the machineType = 256 then
    keyConvertTable = value(member("PCKeyConvertTable").text)
  else
    keyConvertTable = value(member("MacKeyConvertTable").text)
  end if
  keysDown = []
  keyProp = #KeysItIsOKToSend
  Active = 1
  forceKeysDown = []
  gotXtra = 0
  return me
end

on init me
  gotXtra = gUseful.xtrasList[#KeyPoll]
end

on kill me
  Active = 0
  addObjectList = [:]
  deleteObjectList = []
  objects = [:]
  return 0
end

on addObject me, argObj, argPrio
  if voidp(argPrio) then
    argPrio = 50
  end if
  argObj.setaProp(keyProp, 1)
  if busyRepeating then
    addObjectList.addProp(argPrio, argObj)
  else
    if objects.getPos(argObj) = 0 then
      objects.addProp(argPrio, argObj)
    end if
  end if
end

on addObjects me
  repeat with n = 1 to addObjectList.count()
    tmpObj = addObjectList[n]
    if objects.getPos(tmpObj) = 0 then
      objects.addProp(addObjectList.getPropAt(n), tmpObj)
    end if
  end repeat
  addObjectList = [:]
end

on deleteObject me, argObj
  argObj.setaProp(keyProp, 0)
  if busyRepeating then
    deleteObjectList.add(argObj)
  else
    objects.deleteOne(argObj)
  end if
end

on deleteObjects me
  repeat with tmpObj in deleteObjectList
    objects.deleteOne(tmpObj)
  end repeat
  deleteObjectList = []
end

on timeTick me
  if dismissingKeys then
    dismissingKeys = dismissingKeys - 1
  end if
  busyRepeating = 1
  me.check(me.checkPressed())
  me.addObjects()
  me.deleteObjects()
  busyRepeating = 0
end

on keyDown me
  busyRepeating = 1
  me.check(me.checkPressed())
  me.addObjects()
  me.deleteObjects()
  busyRepeating = 0
end

on keyUp me
  busyRepeating = 1
  me.check(me.checkPressed())
  me.addObjects()
  me.deleteObjects()
  busyRepeating = 0
end

on dismissKeys me, argIsTRUE
  dismissingKeys = argIsTRUE
end

on convert me, argFromType, argToType, argVal
  tmpTypeList = keyConvertTable.getProp(argFromType)
  tmp = tmpTypeList.getaProp(argVal)
  if voidp(tmp) then
    return 0
  end if
  if argFromType = #user then
    return tmp.getaProp(argToType)
  end if
  if argToType = #Poll then
    return tmp[2]
  end if
  if argToType = #key then
    return tmp[1]
  end if
  if argToType = #code then
    if argFromType = #key then
      return tmp[1]
    else
      return tmp[2]
    end if
  end if
end

on check me, argKeysDown
  if dismissingKeys then
    exit
  end if
  repeat with tmpID in forceKeysDown
    argKeysDown.add(tmpID)
  end repeat
  tmpPressed = []
  tmpReleased = []
  repeat with tmpCode in argKeysDown
    if not keysDown.getPos(tmpCode) then
      tmpPressed.add(tmpCode)
    end if
  end repeat
  repeat with tmpCode in keysDown
    if not argKeysDown.getPos(tmpCode) then
      tmpReleased.add(tmpCode)
    end if
  end repeat
  keysDown = argKeysDown
  repeat with tmpKey in tmpPressed
    repeat with n = objects.count() down to 1
      tmpObj = objects[n]
      if tmpObj.getaProp(keyProp) then
        if tmpObj.key(#down, tmpKey) then
          exit
        end if
      end if
    end repeat
  end repeat
  repeat with tmpKey in tmpReleased
    repeat with n = objects.count() down to 1
      tmpObj = objects[n]
      if tmpObj.getaProp(keyProp) then
        if tmpObj.key(#up, tmpKey) then
          exit
        end if
      end if
    end repeat
  end repeat
end

on forceKeyDown me, argID, argIsTRUE
  if argIsTRUE then
    if forceKeysDown.getPos(argID) = 0 then
      forceKeysDown.add(argID)
    end if
  else
    forceKeysDown.deleteOne(argID)
  end if
end

on checkPressed me
  if gotXtra then
    return bgAllKeys()
  else
    tmpList = []
    repeat with tmpObj in objects
      if keyPressed(tmpObj.keyCode) then
        tmpList.add(tmpObj.pollCode)
      end if
    end repeat
    return tmpList
  end if
end

on ZZcheckUp me, argKeysDown
  tmpUpKeys = []
  repeat with tmpCode in keysDown
    if not getPos(argKeysDown, tmpCode) then
      add(tmpUpKeys, tmpCode)
    end if
  end repeat
  keysDown = argKeysDown
  if count(tmpUpKeys) then
    nothing()
  end if
  repeat with tmpKey in tmpUpKeys
    repeat with n = count(objects) down to 1
      tmpObj = getAt(objects, n)
      key(tmpObj, #up, tmpKey)
    end repeat
  end repeat
end

on ZZcheckDown me, argKeysDown
  tmpNewDownKeys = []
  repeat with tmpCode in argKeysDown
    if not getPos(keysDown, tmpCode) then
      add(tmpNewDownKeys, tmpCode)
    end if
  end repeat
  keysDown = argKeysDown
  if count(tmpNewDownKeys) then
    nothing()
  end if
  repeat with tmpKey in tmpNewDownKeys
    repeat with n = count(objects) down to 1
      tmpObj = getAt(objects, n)
      if key(tmpObj, #down, tmpKey) then
        exit
      end if
    end repeat
  end repeat
end
