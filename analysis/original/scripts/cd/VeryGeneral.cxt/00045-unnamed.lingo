global gUseful, gDir, gMembers

on prepareMovie
  tmpCP = the number of member "   __!orpZxzx!"
  if not objectp(gUseful) then
    gUseful = new(script("UsefulScript"))
    gUseful.init()
  end if
  gUseful.prepareMovie()
  gDir = new(script("Dir"))
  if objectp(gDir) then
    gDir.init()
  end if
end

on startMovie
  gUseful.startMovie()
  if objectp(gDir) then
    gDir.startMovie()
  end if
end

on stopMovie
  gUseful.stopMovie()
  if objectp(gDir) then
    gDir = gDir.kill()
  end if
end

on ccc
  if objectp(gUseful) then
    gUseful = gUseful.kill()
  end if
  clearGlobals()
end

on idle
  if objectp(gUseful) then
    gUseful.idle()
  end if
end
