global gUseful, gDir, gMembers, gRock, gSystem

on prepareMovie
  tmpCP = the number of member "   __!orpZxzx!"
  if not objectp(gSystem) then
    if stringp(getSystemPref([#SavePotts, #path])) then
      writeFile(getSystemPref([#SavePotts, #path]), EMPTY)
    end if
    gSystem = script("SystemScript").new()
  end if
  if not objectp(gUseful) then
    gUseful = script("UsefulScript").new()
    gUseful.init()
  end if
  gUseful.prepareMovie()
  gDir = script("Dir").new()
  if objectp(gDir) then
    gDir.init()
  end if
end

on startMovie
  gUseful.startMovie()
  if objectp(gDir) then
    gDir.startMovie()
  end if
end

on stopMovie
  gUseful.stopMovie()
  if objectp(gRock) then
    gRock.stopMovie()
  end if
  if objectp(gDir) then
    gDir = gDir.kill()
  end if
end

on idle
  if objectp(gUseful) then
    gUseful.idle()
  end if
end
