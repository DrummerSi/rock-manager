property ancestor, scrollThisObj

on new me, argItemObj
  ancestor = script("DialogScrollMainBH").new(argItemObj, me)
  scrollThisObj = ancestor.itemObj.ancestor.masterObj
  scrollThisObj = scrollThisObj.dlgItemParent.ancestor.masterObj
  scrollThisObj = scrollThisObj.getItem(#Item9)
  return me
end

on kill me
  ancestor = ancestor.kill()
  return 0
end

on getItemSize me, argItemCoord
  return ancestor.defaultItemSize
end

on scrollPaint me
end

on scrollRender me
  scrollThisObj.scrollLocOffset = ancestor.scrollTLPixels
  scrollThisObj.ancestor.masterObj.invalidateRect(scrollThisObj.calcRect)
  updateStage()
end
