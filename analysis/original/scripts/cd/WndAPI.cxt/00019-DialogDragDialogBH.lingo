property itemObj, topWndObj

on new me, argItemObj
  itemObj = argItemObj
  return me
end

on kill me
  itemObj = 0
  return 0
end

on mouse me, argObj, argWhat
  if argWhat = #DownOnOther then
    exit
  end if
  if argWhat = #down then
    topWndObj = itemObj.ancestor.masterObj.getTopWindow()
  else
    if argWhat = #stillDown then
      if objectp(topWndObj) then
        topWndObj.move(argObj.deltaMove)
      end if
    else
      if argWhat = #click then
      end if
    end if
  end if
end
