property m_date_r
global gRock

on new me, argObjMaster
  m_date_r = gRock.m_date
  SPNum = argObjMaster.m_spriteList[#DateText]
  tmpMemb = member("DateNameText")
  sprite(SPNum).loc = point(195, 23)
  sprite(SPNum).member = tmpMemb
  tmpMemb.text = gRock.m_languageManager.getStr(#szidDate, [#FirstUppercase: 1])
  SPNum = argObjMaster.m_spriteList[#DateVal]
  sprite(SPNum).loc = point(194, 36)
  sprite(SPNum).member = member("DateText")
  return me
end

on kill me
  return 0
end

on render me
  str = rGetDateStr()
  member("DateText").text = str
end
