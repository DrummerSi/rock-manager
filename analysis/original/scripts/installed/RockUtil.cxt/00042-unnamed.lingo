on rNewGenerateMeter argItemObj, argFraction, argPrefix
  if voidp(argPrefix) then
    argPrefix = "meter01_"
  end if
  bgMemb = member(argPrefix & "background01")
  itemsList = []
  barMembers = ["Left", "Mid", "Right"]
  repeat with n = 1 to barMembers.count
    memb = member(argPrefix & "line01" & barMembers[n])
    barMembers[n] = memb
  end repeat
  itemDef = [#ID: #BG, #type: #Pic, #Pic: bgMemb.image, #ch: 1, #inOffsetRect: rect(0, 0, 0, 0), #rel: [0, 0, #Auto, #Auto], #usingMouse: 0]
  itemsList.add(itemDef)
  itemDef = [#ID: #left, #type: #Pic, #Pic: barMembers[1].image, #ch: 2, #inOffsetRect: rect(0, 0, 0, 0), #rel: [0, 0, #Auto, #Auto], #usingMouse: 0]
  itemsList.add(itemDef)
  itemDef = [#ID: #Mid, #type: #Pic, #Pic: barMembers[2].image, #ch: 3, #inOffsetRect: rect(0, 0, 0, 0), #rel: [0, 0, 0, #Auto], #usingMouse: 0]
  itemsList.add(itemDef)
  itemDef = [#ID: #right, #type: #Pic, #Pic: barMembers[3].image, #ch: 4, #inOffsetRect: rect(0, 0, 0, 0), #rel: [0, 0, #Auto, #Auto], #usingMouse: 0]
  itemsList.add(itemDef)
  argItemObj.attachDlg(VOID, itemsList)
  BH = script("RockMeterBH").new(argItemObj, argPrefix)
  argItemObj.scriptInstanceList.add(BH)
  if not voidp(argFraction) then
    BH.setMeter(argFraction)
  end if
end
