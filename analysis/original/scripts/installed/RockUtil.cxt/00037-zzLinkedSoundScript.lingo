property sndId, linkedMember, masterObj
global gDir

on new me, argFileName
  masterObj = gDir.soundMasterObj
  sndId = masterObj.getSndId()
  if sndId = 0 then
    pott("no sndid")
  end if
  linkedMember = masterObj.getLinkedMember(argFileName)
  if not objectp(linkedMember) then
    pott("no member")
  end if
  return me
end

on kill me
  sound(sndId).stop()
  return 0
end

on play me
  sound(sndId).play()
end

on preload me
  sound(sndId).queue(linkedMember)
end

on unload me
  sound(sndId).stop()
  masterObj.returnAll(me)
end

on setVol me, argVol
end

on Mute me
end
