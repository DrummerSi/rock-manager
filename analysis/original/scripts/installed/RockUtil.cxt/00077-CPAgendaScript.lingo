property m_objMouse, m_band_r, m_shortCutKeyObj, m_objMaster
global gDir, gRock

on new me, argObjMaster
  m_objMaster = argObjMaster
  m_objMouse = script("MouseObject").new(me, rect(665, 17, 760, 121), [#layer: 10])
  return me
end

on kill me
  m_objMouse = m_objMouse.kill()
  m_objMaster = 0
  return 0
end

on key me, argObj, argWhat, argID
  if argWhat = #down then
    if argID = #Shortcut then
      me.openIt()
    end if
  end if
end

on mouse me, argObj, argWhat
  if argWhat = #click then
    me.openIt()
  else
    if argWhat = #enter then
      member("DateNameText").color = m_objMaster.m_clrTextHilite
      member("AssetsNameText").color = m_objMaster.m_clrTextHilite
    else
      if argWhat = #Leave then
        member("DateNameText").color = m_objMaster.m_clrTextNormal
        member("AssetsNameText").color = m_objMaster.m_clrTextNormal
      end if
    end if
  end if
end

on openIt me
  if gDir.m_objDialogsMaster.getNumOpen() = 0 then
    gDir.m_objDialogsMaster.openDialog(#Admin)
  end if
end
