property addMouseObjectList, deleteMouseObjectList, mouseObjects, latestMouseButton, busyRepeating, dismissingClicks, cursorChanged, Active, mouseLoc, lastMouseLoc, mouseWasOnStage, stageRect, insideObjs, downOnObj, changeLayerObjs, lastMouseUpInfo
global gUseful

on new me
  addMouseObjectList = [:]
  deleteMouseObjectList = []
  changeLayerObjs = [:]
  insideObjs = []
  mouseObjects = [:]
  sort(mouseObjects)
  latestMouseButton = #none
  busyRepeating = 0
  dismissingClicks = 0
  mouseLoc = point(0, 0)
  lastMouseLoc = mouseLoc
  stageRect = rect(0, 0, 640, 480)
  Active = 1
  return me
end

on kill me
  addMouseObjectList = [:]
  deleteMouseObjectList = []
  mouseObjects = [:]
  insideObjs = []
  return 0
end

on init me
end

on mouse me
end

on block me, argIsTRUE
end

on activate me, argIsTRUE
  Active = argIsTRUE
end

on addObject me, argObj, argPrio
  if voidp(argPrio) then
    argPrio = 50
  end if
  if busyRepeating then
    if deleteMouseObjectList.getPos(argObj) = 0 then
      addMouseObjectList.addProp(argPrio, argObj)
    else
    end if
  else
    if mouseObjects.getPos(argObj) = 0 then
      mouseObjects.addProp(argPrio, argObj)
    end if
  end if
end

on addObjects me
  repeat with n = 1 to addMouseObjectList.count()
    tmpObj = addMouseObjectList[n]
    if mouseObjects.getPos(tmpObj) = 0 then
      mouseObjects.addProp(addMouseObjectList.getPropAt(n), tmpObj)
    end if
  end repeat
  addMouseObjectList = [:]
end

on deleteObject me, argObj
  argObj.activate(0)
  if busyRepeating then
    if addMouseObjectList.getPos(argObj) = 0 then
      deleteMouseObjectList.add(argObj)
    else
    end if
  else
    mouseObjects.deleteOne(argObj)
  end if
end

on deleteObjects me
  repeat with tmpObj in deleteMouseObjectList
    mouseObjects.deleteOne(tmpObj)
  end repeat
  deleteMouseObjectList = []
end

on deleteMouseObjectsConnectedTo me, argObj
  tmpBusyRepeating = busyRepeating
  busyRepeating = 1
  repeat with tmpObj in mouseObjects
    if tmpObj.reportObject = argObj then
      me.deleteObject(tmpObj)
    end if
  end repeat
  busyRepeating = tmpBusyRepeating
end

on activateMouseObjectsOfType me, argType, YesNo
  tmpBusyRepeating = busyRepeating
  busyRepeating = 1
  repeat with tmpObj in mouseObjects
    if tmpObj.type = argType then
      tmpObj.activate(YesNo)
    end if
  end repeat
  busyRepeating = tmpBusyRepeating
end

on timeTick me
  if Active = 0 then
    exit
  end if
  if dismissingClicks > 0 then
    dismissingClicks = dismissingClicks - 1
  end if
  busyRepeating = 1
  mouseLoc = point(the mouseH, the mouseV)
  tmpIsOnStage = inside(mouseLoc, stageRect)
  if tmpIsOnStage and not mouseWasOnStage then
    gUseful.cursors.display()
  end if
  mouseWasOnStage = tmpIsOnStage
  cursorChanged = VOID
  tmpOKToEnter = 1
  repeat with n = mouseObjects.count() down to 1
    if Active = 0 then
      next repeat
    end if
    tmpCheck = mouseObjects[n].check(mouseLoc, tmpOKToEnter)
    if tmpCheck then
      tmpOKToEnter = 0
    end if
  end repeat
  if objectp(gUseful) then
    gUseful.cursors.setCursor(cursorChanged)
  end if
  me.addObjects()
  me.deleteObjects()
  me.changeLayerObjs()
  busyRepeating = 0
  lastMouseLoc = mouseLoc
end

on mouseDown me, argPoint
  mouseLoc = argPoint
  if Active = 0 then
    exit
  end if
  if dismissingClicks then
    exit
  end if
  busyRepeating = 1
  if latestMouseButton = #down then
    exit
  end if
  latestMouseButton = #down
  tmpDownOnNr = 0
  repeat with n = mouseObjects.count down to 1
    if Active = 0 then
      next repeat
    end if
    if mouseObjects[n].checkDown(mouseLoc) then
      tmpDownOnNr = n
      downOnObj = mouseObjects[n]
      exit repeat
    end if
  end repeat
  tmpDownOnObj = 0
  if tmpDownOnNr then
    tmpDownOnObj = mouseObjects[tmpDownOnNr]
  end if
  repeat with n = mouseObjects.count() down to 1
    if n <> tmpDownOnNr then
      mouseObjects[n].otherReacted(#DownOnOther, #DownOnOther)
    end if
  end repeat
  me.addObjects()
  me.deleteObjects()
  me.changeLayerObjs()
  busyRepeating = 0
end

on mouseUp me, argPoint
  mouseLoc = argPoint
  if Active = 0 then
    exit
  end if
  busyRepeating = 1
  if latestMouseButton = #up then
    exit
  end if
  latestMouseButton = #up
  tmpOKToClick = 1
  repeat with n = mouseObjects.count() down to 1
    if Active = 0 then
      next repeat
    end if
    if checkUp(mouseObjects[n], mouseLoc, tmpOKToClick) then
      tmpOKToClick = 0
    end if
  end repeat
  me.addObjects()
  me.deleteObjects()
  busyRepeating = 0
end

on setIsInside me, argObj, argIsTRUE
  if argIsTRUE then
    if insideObjs.getPos(argObj) = 0 then
      insideObjs.add(argObj)
    end if
  else
    insideObjs.deleteOne(argObj)
  end if
end

on dismissClicks me, argIsTRUE
  dismissingClicks = argIsTRUE
end

on cursorChange me, argWhich
  if voidp(cursorChanged) then
    cursorChanged = argWhich
  end if
end

on getMouseLoc me
  return mouseLoc
end

on changeLayer me, argObj, argLayer
  if addMouseObjectList.getPos(argObj) then
    addMouseObjectList.deleteOne(argObj)
  end if
  changeLayerObjs.addProp(argLayer, argObj)
end

on changeLayerObjs me
  repeat with n = 1 to changeLayerObjs.count()
    tmpObj = changeLayerObjs[n]
    mouseObjects.deleteOne(tmpObj)
    mouseObjects.addProp(changeLayerObjs.getPropAt(n), tmpObj)
  end repeat
  if changeLayerObjs.count() then
  end if
  changeLayerObjs = [:]
end

on getCurrentlyInside me
  lst = []
  repeat with n = mouseObjects.count() down to 1
    if mouseObjects[n].isInside then
      lst.addAt(1, mouseObjects[n])
    end if
  end repeat
  return lst
end
