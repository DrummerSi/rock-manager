property counter, framesPerTick, Active, addObjects, deleteObjects, attachedToObject, totalTicks, ID, timerProp, whichGroupObjectList, numGroups, objectsPerGroup, speedFactor

on new me, argFramesPerTick, argAttachToObject, argID
  ID = argID
  timerProp = symbol("TimerItIsOKToTick" & string(ID))
  framesPerTick = argFramesPerTick
  counter = framesPerTick
  Active = 1
  addObjects = [:]
  deleteObjects = []
  attachedToObject = argAttachToObject
  if objectp(attachedToObject) then
    attachedToObject.addObject(me)
  end if
  totalTicks = 0
  speedFactor = 1
  numGroups = framesPerTick
  objectsPerGroup = []
  repeat with n = 1 to numGroups
    tmp = [:]
    tmp.sort()
    objectsPerGroup.add(tmp)
  end repeat
  whichGroupObjectList = [:]
  return me
end

on kill me
  if objectp(attachedToObject) then
    attachedToObject.deleteObject(me)
  end if
  return 0
end

on getrate me
  return framesPerTick
end

on changeRate me, argNewRate, argTickAsWell
  framesPerTick = argNewRate
  counter = framesPerTick + 1
  if argTickAsWell then
    timeTick(me)
  end if
end

on tickThroughAllGroups me
  if not Active then
    exit
  end if
  repeat with n = counter + 1 to framesPerTick
    me.timeTick()
  end repeat
end

on timeTick me, argObj, argOption
  if Active then
    refreshLists(me)
    repeat with m = 1 to speedFactor
      totalTicks = totalTicks + 1
      counter = counter + 1
      if counter > framesPerTick then
        counter = 1
      end if
      tmpObjs = objectsPerGroup[counter]
      repeat with n = tmpObjs.count down to 1
        tmpObj = tmpObjs[n]
        if tmpObj.getaProp(timerProp) = 1 then
          tmpObj.timeTick(me, argOption, framesPerTick)
        end if
        if not Active then
          exit repeat
        end if
      end repeat
    end repeat
  end if
end

on activate me, YesNo
  Active = YesNo
end

on addObject me, argObj, argPrio, argGroupNr
  if voidp(argPrio) then
    argPrio = 50
  end if
  argObj.setaProp(timerProp, 1)
  if voidp(argGroupNr) then
    argGroupNr = random(numGroups)
  end if
  if deleteObjects.getPos(argObj) = 0 then
    addObjects.addProp(argPrio, argObj)
    whichGroupObjectList.addProp(argObj, argGroupNr)
  else
  end if
end

on deleteObject me, argObj
  setaProp(argObj, timerProp, 0)
  if addObjects.getPos(argObj) = 0 then
    tmpGroupNr = whichGroupObjectList.getaProp(argObj)
    if voidp(tmpGroupNr) then
    else
      if deleteObjects.getPos(argObj) then
      else
        deleteObjects.add(argObj)
      end if
    end if
  else
  end if
end

on refreshLists me
  repeat with n = 1 to addObjects.count()
    tmpObj = addObjects[n]
    tmpGroupNr = whichGroupObjectList.getaProp(tmpObj)
    tmpObjs = objectsPerGroup[tmpGroupNr]
    if tmpObjs.getPos(tmpObj) = 0 then
      tmpObjs.addProp(addObjects.getPropAt(n), tmpObj)
    end if
  end repeat
  addObjects = [:]
  repeat with tmpObj in deleteObjects
    tmpGroupNr = whichGroupObjectList.getaProp(tmpObj)
    whichGroupObjectList.deleteProp(tmpObj)
    tmpObjs = objectsPerGroup[tmpGroupNr]
    tmpObjs.deleteOne(tmpObj)
  end repeat
  deleteObjects = []
end
