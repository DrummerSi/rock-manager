property frameTimer, mouseObjects, cuePointMaster, animationTimer, speedCategory, checkTicksAfterNFrames, startTicks, memoryLevel, keyObjects, systemKeys, angles, MIAWs, cursors, currentMovie, soundObj, idleTimer, xtrasList, currentMovieObj, debug, isRunning, soundFileExt

on new me
  return me
end

on init me
  isRunning = 0
  findXtras(me)
  currentMovieObj = new(script("CurrentMovieScript"))
  debug = script("DebugToolsScript").new()
  frameTimer = new(script("Timer"), 1, 0, #frame)
  idleTimer = new(script("Timer"), 1, 0, #idle)
  keyObjects = new(script("KeysManager"))
  addObject(frameTimer, keyObjects)
  animationTimer = new(script("Timer"), 2, frameTimer, #anim)
  mouseObjects = new(script("MouseObjectManager"))
  addObject(frameTimer, mouseObjects)
  if mouseObjects.handler(#init) then
    mouseObjects.init()
  end if
  soundFileExt = ".swa"
  me.setSoundSystem(#Director)
  cuePointMaster = new(script("CuePointMaster"))
  angles = new(script("AnglesScript"), 360)
  MIAWs = new(script("MIAWsScript"))
  cursors = new(script("CursorScript"))
  speedCategory = 1
  startCheckingSpeed(me)
  if the freeBlock > (10 * 1024 * 1024) then
    memoryLevel = 10
  else
    if the freeBlock > (4 * 1024 * 1024) then
      memoryLevel = 5
    else
      memoryLevel = 2
    end if
  end if
  systemKeys = new(script("SystemKeys"))
end

on kill me
  if objectp(soundObj) then
    soundObj = soundObj.kill()
  end if
  if objectp(cursors) then
    cursors = cursors.kill()
  end if
  if objectp(MIAWs) then
    MIAWs = MIAWs.kill()
  end if
  if objectp(angles) then
    angles = angles.kill()
  end if
  if objectp(systemKeys) then
    systemKeys = systemKeys.kill()
  end if
  deleteObject(frameTimer, mouseObjects)
  if objectp(mouseObjects) then
    mouseObjects = mouseObjects.kill()
  end if
  if objectp(idleTimer) then
    idleTimer = idleTimer.kill()
  end if
  if objectp(frameTimer) then
    frameTimer = frameTimer.kill()
  end if
  if objectp(cuePointMaster) then
    cuePointMaster = cuePointMaster.kill()
  end if
  if objectp(currentMovieObj) then
    currentMovieObj = currentMovieObj.kill()
  end if
  return 0
end

on prepareMovie me
  isRunning = 1
  currentMovie = fileStripName(the movieName)
  currentMovieObj.prepareMovie()
end

on startMovie me
  currentMovieObj.startMovie()
end

on stopMovie me
  isRunning = 0
  currentMovieObj.stopMovie()
end

on startCheckingSpeed me
  checkTicksAfterNFrames = 2
  startTicks = the ticks
end

on loop me
  timeTick(frameTimer)
  if checkTicksAfterNFrames then
    checkTicksAfterNFrames = checkTicksAfterNFrames - 1
    if checkTicksAfterNFrames = 0 then
      tmpTicks = the ticks - startTicks
      if tmpTicks > 300 then
        speedCategory = 2
      end if
    end if
  end if
end

on idle me
  timeTick(idleTimer)
end

on findXtras me
  xtrasList = [:]
  repeat with n = 1 to the number of xtras
    addProp(xtrasList, symbol(xtra(n).name), 1)
  end repeat
end

on setSoundSystem me, argType, argVolSettings
  if voidp(argVolSettings) then
    argVolSettings = [#SpeakVol: 70, #FXVol: 70, #DemoVol: 100, #PreviewMusicVol: 60, #PlaceVol: 85, #DateTickVol: 25, #CityBGVol: 35, #MissionIntroVol: 70]
  end if
  if objectp(soundObj) then
    if (soundObj.isDX = 1) and (argType = #xtra) then
      exit
    end if
    if (soundObj.isDX = 0) and (argType = #Director) then
      exit
    end if
    soundObj = soundObj.kill()
  end if
  if argType = #xtra then
    if xtrasList[#DirectSound] = 1 then
      soundObj = script("DXSoundHandlerScript").new()
    else
      pott("DSound Xtra not available!")
    end if
  end if
  if not objectp(soundObj) then
    soundObj = script("DirSoundHandlerScript").new()
  end if
  if objectp(soundObj) then
    soundObj.init()
  end if
  soundObj.setVolSettings(argVolSettings)
end
