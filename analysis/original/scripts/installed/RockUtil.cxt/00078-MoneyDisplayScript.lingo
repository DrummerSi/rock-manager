global gRock

on new me, argObjMaster
  SPNum = argObjMaster.m_spriteList[#MoneyText]
  tmpMemb = member("AssetsNameText")
  sprite(SPNum).loc = point(698, 34)
  sprite(SPNum).member = tmpMemb
  tmpMemb.text = gRock.m_languageManager.getStr(#szidAssets, [#FirstUppercase: 1])
  SPNum = argObjMaster.m_spriteList[#MoneyVal]
  sprite(SPNum).loc = point(671, 55)
  sprite(SPNum).member = member("MoneyText")
  me.registerWithNewPlayer()
  return me
end

on kill me
  gRock.m_player.Money.NotifyList.deleteOne(me)
  return 0
end

on registerWithNewPlayer me
  gRock.m_player.Money.NotifyList.deleteOne(me)
  gRock.m_player.Money.NotifyList.add(me)
  me.render()
end

on render me
  member("MoneyText").text = rCurrency(gRock.m_player.Money.getVal())
end

on notification me, argObj, argWhat
  me.render()
end

on notEnoughMoney me
end
