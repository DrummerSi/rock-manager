property m_numFrames, m_firstFrame, m_SP, m_val, m_showVal, m_vel, m_convertRange
global gUseful

on new me, argObjMaster
  m_firstFrame = member("credometer01_0000").number
  m_numFrames = 41
  m_SP = sprite(argObjMaster.m_spriteList[#CredMeter])
  m_SP.loc = point(426, 32)
  m_vel = 0.0
  m_showVal = 0.0
  m_val = 0.0
  m_convertRange = [-7.0, 14.0]
  gUseful.frameTimer.addObject(me)
  return me
end

on kill me
  gUseful.frameTimer.deleteObject(me)
  return 0
end

on timeTick me
  if m_vel <> 0 then
    diff = m_showVal - m_val
    m_vel = m_vel - (diff * 0.10000000000000001)
    m_showVal = m_showVal + m_vel
    if m_showVal < 0 then
      m_showVal = 0.0
      m_vel = -m_vel
    else
      if m_showVal > 1 then
        m_showVal = 1.0
        m_vel = -m_vel
      end if
    end if
    m_vel = m_vel * 0.80000000000000004
    if abs(m_vel) < 0.0001 then
      m_vel = 0
      m_showVal = m_val
    end if
    me.showVal(m_showVal)
  end if
end

on changeMeter me, argVal
  m_showVal = m_val
  m_val = argVal
  diff = m_showVal - m_val
  m_vel = -diff * 0.10000000000000001
  me.timeTick()
end

on setVal me, argVal
  m_val = argVal
end

on showVal me, argVal
  exit
  tmp = integer(argVal * (m_numFrames - 1)) + 1
  if tmp < 1 then
    tmp = 1
  else
    if tmp > m_numFrames then
      tmp = m_numFrames
    end if
  end if
  m_SP.member = member(m_firstFrame - 1 + tmp)
end

on setConvVal me, argVal
  tmp = (argVal - m_convertRange[1]) / (m_convertRange[2] - m_convertRange[1])
  me.changeMeter(tmp)
end

on getConvVal me
  return (m_val * (m_convertRange[2] - m_convertRange[1])) + m_convertRange[1]
end
