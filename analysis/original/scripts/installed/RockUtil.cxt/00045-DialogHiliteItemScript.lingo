property itemObj, hilitedObj

on new me
  hilited = 0
  return me
end

on kill me
  return 0
end

on mouse me, argObj, argWhat, argOption
  if argWhat = #click then
    if objectp(hilitedObj) then
      itemObj = hilitedObj.dialogObj.getItem(#BG)
      itemObj.setOneProp(#FgColorStr, "#000000")
    end if
    hilitedObj = argOption
    itemObj = hilitedObj.dialogObj.getItem(#BG)
    itemObj.setOneProp(#FgColorStr, "#AAAAAA")
  end if
end
