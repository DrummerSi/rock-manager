property ancestor, m_musician_r, m_musicians_r, m_band_r, m_instrument, m_tellAboutMusicianObj, m_scroller, m_possibleInstruments, m_orgMusician_r
global gDir, gRock

on new me, argOptions
  m_tellAboutMusicianObj = argOptions[#ReportTo]
  argOptions.setaProp(#ReportTo, me)
  argOptions.setaProp(#child, me)
  ancestor = script("DlgRockAncestorScript").new(argOptions)
  m_instrument = argOptions[#Instrument]
  if voidp(m_instrument) then
    m_instrument = #Guitar
  end if
  m_band_r = gRock.m_context.getFocus(#Band)
  m_musicians_r = m_band_r.getMusicianObjs().duplicate()
  m_orgMusician_r = argOptions[#CurrentlyPlaying]
  repeat with n = m_musicians_r.count down to 1
    musician_r = m_musicians_r[n]
    if gDir.m_mixerObj.m_musiciansPlaying.getPos(musician_r) > 0 then
      m_musicians_r.deleteAt(n)
    end if
  end repeat
  if (m_musicians_r.getPos(m_orgMusician_r) = 0) and objectp(m_orgMusician_r) then
    m_musicians_r.addAt(1, m_orgMusician_r)
  end if
  studIDs = argOptions[#StudioMusicianIDs]
  repeat with ID in studIDs
    obj_r = gRock.m_classManager.getObjByIDAndClass(ID, #StudioMusician)
    m_musicians_r.add(obj_r)
  end repeat
  itemObj = ancestor.m_objDlg.getItemByPath([#Instrument, #Head, #icon])
  if objectp(itemObj) then
    itemObj.setOneProp(#Pic, "Dummy")
  end if
  itemObj = ancestor.m_objDlg.getItemByPath([#Instrument, #Head, #Info])
  if objectp(itemObj) then
    itemObj.setOneProp(#editData, rGetStr(#szidInstrument))
  end if
  itemObj = ancestor.m_objDlg.getItemByPath([#Instrument, #Chooser, #text])
  if objectp(itemObj) then
    r = itemObj.getOneProp(#inOffsetRect)
    r[3] = 238
    itemObj.setOneProp(#inOffsetRect, r)
  end if
  allScrollData = []
  repeat with musician_r in m_musicians_r
    if musician_r.className = #StudioMusician then
      tmpGfx = "portrait_actor00_small"
    else
      tmpGfx = getContextOKFileName(#PortraitSmall, musician_r.Gfx)
    end if
    allScrollData.add(rDlgCreateScrollItemInfo(musician_r, musician_r, #Mixer))
  end repeat
  musician_r = m_orgMusician_r
  if not objectp(musician_r) then
    musician_r = m_musicians_r[1]
  else
  end if
  me.setMusician(musician_r)
  itemObj = ancestor.m_objDlg.getItemByPath([#ScrollView, #Head1, #Info])
  if objectp(itemObj) then
    itemObj.setOneProp(#editData, rGetStr(#szidMusician))
  end if
  itemObj = ancestor.m_objDlg.getItemByPath([#ScrollView, #Head2, #Info])
  if objectp(itemObj) then
    itemObj.setOneProp(#editData, rGetStr(#szidPrice))
  end if
  itemObj = ancestor.m_objDlg.getItemByPath([#ScrollView, #Frame1])
  r = itemObj.getOneProp(#inOffsetRect)
  r[3] = 240
  r[4] = 132
  itemObj.setOneProp(#inOffsetRect, r)
  ancestor.m_objDlg.recalc(#DontPaint)
  itemObj = ancestor.m_objDlg.getItemByPath([#ScrollView, #Frame2])
  rct = itemObj.getOnStageRect()
  rct = rct + rect(2, 2, -2, -2)
  m_scroller = script("CPScrollerScript").new(me, ancestor.getSPOverDlg(), allScrollData, rct, ancestor.m_objDlg.highestMouseLayer)
  ancestor.render()
  return me
end

on kill me
  if objectp(m_scroller) then
    m_scroller = m_scroller.kill()
  end if
  if objectp(m_tellAboutMusicianObj) then
    m_tellAboutMusicianObj.Report(me, #ClosedDlg)
  end if
  ancestor.kill()
  return 0
end

on Report me, argObj, argWhat, argOption
  if argObj = m_scroller then
    if argWhat = #select then
      me.setMusician(argOption.m_ID)
    end if
  end if
end

on mouse me, argObj, argWhat, argOption
  if objectp(argOption) then
    if argWhat = #click then
      ID = argOption.getOneProp(#ID)
      IDStr = string(ID)
      if ID = #ButtonOK then
        if m_musician_r <> m_orgMusician_r then
          if m_musician_r.className = #StudioMusician then
            if gRock.m_player.hasThisMoney(m_musician_r.WantedSalary) then
              gRock.m_player.transactMoney(-m_musician_r.WantedSalary, [#Studio, #StudioMusicians])
            else
              rWarnMoney()
              exit
            end if
          end if
        end if
        m_tellAboutMusicianObj.Report(me, #ChoseMusician, [#Musician: m_musician_r, #Instrument: m_instrument])
        me.kill()
      else
        if ID = #ButtonCancel then
          ancestor.mouse(argObj, argWhat, argOption)
        else
          if offset("Arrow", IDStr) then
            if ID = #ArrowUp then
              me.setInstrument(-1)
            else
              if ID = #ArrowDown then
                me.setInstrument(1)
              end if
            end if
          else
            if offset("ListItem", IDStr) then
              nrInList = value(IDStr.char[9..IDStr.length])
              if nrInList <= m_musicians_r.count() then
                m_musician_r = m_musicians_r[nrInList]
                me.setMusician(m_musician_r)
              end if
            end if
          end if
        end if
      end if
    end if
  end if
end

on setInstrument me, argDir
  if integerp(argDir) then
    tmpPos = m_possibleInstruments.getPos(m_instrument)
    tmpPos = tmpPos + argDir
    if (tmpPos < 1) or (tmpPos > m_possibleInstruments.count) then
      exit
    end if
    m_instrument = m_possibleInstruments[tmpPos]
  else
    m_instrument = argDir
  end if
  info_r = gRock.m_classManager.getObjByIDAndClass(m_instrument, #InstrumentInfo)
  itemObj = ancestor.m_objDlg.getItemByPath([#Instrument, #Chooser, #text])
  if objectp(itemObj) then
    itemObj.setOneProp(#editData, info_r.name)
  end if
end

on setMusician me, argObj
  m_musician_r = argObj
  tmpInstruments = gRock.m_classManager.getPropsInClass(#InstrumentalSkills)
  m_possibleInstruments = []
  if m_musician_r.className = #StudioMusician then
    repeat with n = 1 to tmpInstruments.count
      m_possibleInstruments.add(tmpInstruments.getPropAt(n))
    end repeat
    m_possibleInstruments.deleteOne(#Vocals)
  else
    repeat with n = 1 to tmpInstruments.count
      if rgetProp(m_musician_r.InstrumentalSkills, tmpInstruments.getPropAt(n)) > 0 then
        m_possibleInstruments.add(tmpInstruments.getPropAt(n))
      end if
    end repeat
  end if
  if m_possibleInstruments.getPos(m_instrument) > 0 then
    m_possibleInstruments.deleteOne(m_instrument)
    m_possibleInstruments.addAt(1, m_instrument)
  end if
  m_instrument = m_possibleInstruments[1]
  setMixerMusicianInfoSheet(m_musician_r, ancestor.m_objDlg, m_instrument)
  me.setInstrument(m_instrument)
end
