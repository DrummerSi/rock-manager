on calcProbList argList
  tmpProbList = [:]
  sort(tmpProbList)
  tmpTotProb = 0
  tmpNrOfSelectable = 0
  repeat with n = 1 to argList.count()
    tmpWeigth = argList[n]
    tmpID = argList.getPropAt(n)
    tmpTotProb = tmpTotProb + tmpWeigth
    if tmpWeigth > 0 then
      addProp(tmpProbList, tmpTotProb, tmpID)
    end if
  end repeat
  return tmpProbList
end

on getRandFromProbList argProbList
  tmpTotProb = argProbList.getPropAt(argProbList.count())
  tmpRnd = random(tmpTotProb)
  addProp(argProbList, tmpRnd, -1)
  tmpPos = getPos(argProbList, -1)
  deleteAt(argProbList, tmpPos)
  return argProbList[tmpPos]
end
