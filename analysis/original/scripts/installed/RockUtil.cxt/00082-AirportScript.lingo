property flippers, running, Translate, reportObj, selectedID, numDone
global gDB, gUseful

on new me, argReportObj, argSP, argLoc
  reportObj = argReportObj
  if voidp(argSP) then
    argSP = 10
  end if
  if voidp(argLoc) then
    argLoc = the loc of sprite argSP
  end if
  Translate = ["-", 30, ".", 30, ",", 41, " ", 42, "", 27, "", 28, "", 29]
  flippers = []
  repeat with n = 1 to 13
    add(flippers, new(script("FlipLetterScript"), me, argSP + ((n - 1) * 3), n, argLoc))
  end repeat
  running = 0
  selectedID = 0
  addObject(gUseful.frameTimer, me)
  return me
end

on kill me
  deleteObject(gUseful.frameTimer, me)
  return 0
end

on go me, argName, argID
  numDone = 0
  selectedID = argID
  if length(argName) > count(flippers) then
    argName = char 1 to count(flippers) of argName
  end if
  repeat with n = length(argName) to count(flippers) - 1
    argName = argName & " "
  end repeat
  repeat with n = 1 to count(flippers)
    tmpLetter = charToNum(char n of argName)
    tmpPos = getPos(Translate, char n of argName)
    if tmpPos then
      tmpLetter = getAt(Translate, tmpPos + 1)
    else
      if (tmpLetter <= 57) and (tmpLetter >= 48) then
        if tmpLetter = 48 then
          tmpLetter = 58
        else
          tmpLetter = tmpLetter - 48
        end if
        tmpLetter = tmpLetter + 30
      else
        tmpLetter = tmpLetter - 64
      end if
    end if
    gotoLetter(getAt(flippers, n), tmpLetter)
  end repeat
  running = 1
end

on timeTick me
  if running then
    repeat with tmpObj in flippers
      timeTick(tmpObj)
    end repeat
  end if
end

on oneDone me, argObj
  numDone = numDone + 1
  if numDone = count(flippers) then
    running = 0
    if objectp(reportObj) then
      Report(reportObj, me, #done, selectedID)
    end if
  end if
end
