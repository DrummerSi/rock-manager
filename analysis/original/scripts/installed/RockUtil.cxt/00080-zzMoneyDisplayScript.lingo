property m_player_r
global gRock

on new me, argObjMaster
  m_player_r = gRock.m_classManager.getObjByIDAndClass(#player, #player)
  m_player_r.Money.NotifyList.add(me)
  SPNum = argObjMaster.m_spriteList[#MoneyText]
  tmpMemb = member("AssetsNameText")
  sprite(SPNum).loc = point(78, 23)
  sprite(SPNum).member = tmpMemb
  tmpMemb.text = gRock.m_languageManager.getStr(#szidAssets, [#FirstUppercase: 1])
  SPNum = argObjMaster.m_spriteList[#MoneyVal]
  sprite(SPNum).loc = point(79, 36)
  sprite(SPNum).member = member("MoneyText")
  me.render()
  return me
end

on kill me
  m_player_r.Money.NotifyList.deleteOne(me)
  return 0
end

on render me
  member("MoneyText").text = rCurrency(m_player_r.Money.getVal())
end

on notification me, argObj, argWhat
  me.render()
end

on notEnoughMoney me
end
