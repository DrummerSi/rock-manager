property ancestor, child, className, belongsTo, _killed, normal, Current, min, max, GainFact, LoseFact
global gRock

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  className = #DynamicVar
  normal = 0
  Current = 0
  min = 0
  max = 1
  GainFact = 1
  LoseFact = 1
  return me
end

on kill me
  _killed = 1
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end

on timeTick me
end

on setOneProp me, argProp, argVal
  if voidp(argProp) then
    argProp = #Current
  end if
  me.setaProp(argProp, argVal)
end

on getOneProp me, argProp
  if voidp(argProp) then
    argProp = #Current
  end if
  return me.getaProp(argProp)
end
