property m_reasons, m_strings
global gRock

on new me
  Live = gRock.m_classManager.getObjByIDAndClass(#Live01, #Live)
  tmpInfo = rDefLikesAlbum(Live, VOID, [#music: 1, #image: 1, #SongType: 1, #quality: 1, #Freshness: 0.29999999999999999], #ExtraInfo)
  pott(me.getOpinions(Live, tmpInfo))
end

on setInPropList me, argList, argPropPath, argVal
  tmp = argPropPath.duplicate()
  lastProp = tmp[tmp.count]
  tmp.deleteAt(tmp.count)
  repeat with n = 1 to tmp.count
    tmpSub = argList.getaProp(tmp[n])
    if voidp(tmpSub) then
      tmpSub = [:]
      argList.setaProp(tmp[n], tmpSub)
    end if
    argList = tmpSub
  end repeat
  argList.setaProp(lastProp, argVal)
end

on getOpinions me, argPlace, argLikesInfo
  if 0 then
    tmpLikeSorted = makePropListOfList([-2.33329999999999993, [#StyleMix, #Dance, #Hi], 0.25, [#StyleMix, #Punk, #Hi], 0.25, [#StyleMix, #Pop, #Hi], 0.15279999999999999, [#StyleMixTotal], 0.33329999999999999, [#StyleMix, #Metal, #Lo], -0.6522, [#quality], 0.66669999999999996, [#StyleMix, #Boring, #Hi], 0.75, [#StyleMix, #rock, #Hi], -1.0, [#SongType, #Hi]])
    tmpLikeSorted.sort()
    argLikesInfo = [#Like: -0.37469999999999998, #LikeSorted: tmpLikeSorted, #Freshness: -0.027]
  end if
  tmpLikeSorted = argLikesInfo[#LikeSorted]
  tmpLike = argLikesInfo[#Like]
  m_strings = [#GoodBad: "<ÛCPlace.Name> gillar <good1>, men tycker <bad1>.", #BadBad: "<ÛCPlace.Name> tycker <bad1>. Dessutom tycker de <bad2>.", #Positive: " gillar ", #Negative: ", men tycker ", #Negative1: " tycker ", #Negative2: ". Dessutom tycker de ", #QualityGood1: "inspelningen", #QualityGood2: "verkligen inspelningen", #QualityBad1: "att inspelningen lter dligt", #QualityBad2: "att inspelningen lter askasst", #SongTypeLoBad1: "lten r lite fr alternativ", #SongTypeLoBad2: "lten r alldeles fr alternativ", #SongTypeHiBad1: "lten r lite fr kommersiell", #SongTypeHiBad2: "lten r alldeles fr kommersiell", #StyleMixTotalGood1: "bandets musik och stil", #StyleMixTotalGood2: "verkligen bandets musik och stil", #StyleMixRockHiBad1: "stilen drar fr mycket t rock", #StyleMixRockHiBad2: "det r alldeles fr R.O.C.K", #StyleMixRockLoBad1: "det r lite lite rock", #StyleMixRockLoBad2: "det r alldeles fr lite R.O.C.K.", #StyleMixPopHiBad1: "stilen drar fr mycket t pop", #StyleMixPopHiBad2: "det r alldeles fr pop", #StyleMixPopLoBad1: "det r lite lite pop", #StyleMixPopLoBad2: "det r alldeles fr pop", #StyleMixMetalHiBad1: "stilen drar fr mycket t metal", #StyleMixMetalHiBad2: "det r alldeles fr metal", #StyleMixMetalLoBad1: "det r lite lite metal", #StyleMixMetalLoBad2: "det r alldeles fr metal", #StyleMixDanceHiBad1: "stilen drar fr mycket t dance", #StyleMixDanceHiBad2: "det r alldeles fr dance", #StyleMixDanceLoBad1: "det r lite lite dance", #StyleMixDanceLoBad2: "det r alldeles fr dance", #StyleMixBoringHiBad1: "stilen drar fr mycket t boring", #StyleMixBoringHiBad2: "det r alldeles fr boring", #StyleMixBoringLoBad1: "det r lite lite boring", #StyleMixBoringLoBad2: "det r alldeles fr boring"]
  tmpLevels = makePropListOfList([-10, #Bad3, -1, #Bad2, 0, #Bad1, 0.5, #Good1, 10, #Good2])
  tmpLevels.sort()
  m_reasons = [:]
  repeat with n = 1 to tmpLikeSorted.count
    tmp = tmpLikeSorted[n].duplicate()
    if tmp.count = 1 then
      tmp.add(#none)
    end if
    tmpInfo = [tmpLikeSorted.getPropAt(n), tmp[tmp.count]]
    tmp.deleteAt(tmp.count)
    me.setInPropList(m_reasons, tmp, tmpInfo)
  end repeat
  tmpQuality = m_reasons[#quality][1]
  tmpSongType = m_reasons[#SongType][1]
  tmpStyleSorted = [:]
  tmpStyleSorted.sort()
  repeat with n = 1 to m_reasons[#StyleMix].count
    tmpStyleSorted.addProp(m_reasons[#StyleMix][n][1], [m_reasons[#StyleMix].getPropAt(n), m_reasons[#StyleMix][n][2]])
  end repeat
  if tmpStyleSorted.getPropAt(1) >= 0 then
    tmpNoStyleMixSubZero = 1
  else
    tmpNoStyleMixSubZero = 0
  end if
  comments = [:]
  str = EMPTY
  if tmpQuality > 0 then
    if tmpNoStyleMixSubZero = 1 then
      if tmpSongType > 0 then
      else
        if m_reasons[#quality][1] > m_reasons[#StyleMixTotal][1] then
          comments.addProp(#Good, me.makeComment(#quality))
        else
          comments.addProp(#Good, me.makeComment(#StyleMixTotal))
        end if
        comments.addProp(#Bad, me.makeComment(#SongType))
      end if
    else
      comments.addProp(#Good, me.makeComment(#quality))
      tmp = [:]
      tmp.sort()
      tmp.addProp(tmpStyleSorted.getPropAt(1), [#StyleMix, tmpStyleSorted[1][1]])
      tmp.addProp(m_reasons[#SongType][1], #SongType)
      comments.addProp(#Bad, me.makeComment(tmp[1]))
    end if
  else
    if tmpNoStyleMixSubZero = 1 then
      comments.addProp(#Good, me.makeComment(#StyleMixTotal))
      if m_reasons[#SongType][1] < m_reasons[#quality][1] then
        comments.addProp(#Bad, me.makeComment(#SongType))
      else
        comments.addProp(#Bad, me.makeComment(#quality))
      end if
    else
      if tmpLike > -0.5 then
        tmp = [:]
        tmp.sort()
        tmp.addProp(tmpStyleSorted.getPropAt(1), [#StyleMix, tmpStyleSorted[1][1]])
        tmp.addProp(m_reasons[#SongType][1], #SongType)
        tmp.addProp(m_reasons[#quality][1], #quality)
        comments.addProp(#Bad, me.makeComment(tmp[1]))
        comments.addProp(#Bad, me.makeComment(tmp[2]))
      else
        str = str & rGetStr(#szidDemoFbHopeless)
      end if
    end if
  end if
  if comments.count then
    tmpCommentsCnt = [#Good: 0, #Bad: 0]
    tmpPropStr = EMPTY
    repeat with n = 1 to comments.count
      prop = comments.getPropAt(n)
      tmpCommentsCnt[prop] = tmpCommentsCnt[prop] + 1
      gRock.m_executor.m_parseAndCalcObj.m_expressionCreatedVars.setaProp(symbol(string(prop) & string(tmpCommentsCnt[prop])), comments[n])
      tmpPropStr = tmpPropStr & string(prop)
    end repeat
    szid = symbol("szidDemoFb" & tmpPropStr)
    filloutStr = rGetStr(szid)
    str = gRock.m_languageManager.dereference(filloutStr)
  end if
  band_r = gRock.m_context.getFocus(#Band)
  if ((band_r.LiveReputation < 0.5) and (tmpLike > -0.10000000000000001)) or (band_r.LiveReputation < argLikesInfo[#target].MinLiveReputation) then
    str = str & rGetStr(#szidDemoFbLiveReputation)
  end if
  return str
end

on makeComment me, argPropPath
  if not listp(argPropPath) then
    argPropPath = [argPropPath]
  end if
  tmpInfo = descendIntoList(m_reasons, argPropPath)
  val = tmpInfo[1]
  reason = tmpInfo[2]
  tmpLevels = makePropListOfList([-10, #Bad3, -1, #Bad2, 0, #Bad1, 0.5, #Good1, 10, #Good2])
  tmpLevels.sort()
  level = me.comesBeforeValInPropList(tmpLevels, val)
  tmp = argPropPath.duplicate()
  if reason <> #none then
    tmp.add(reason)
  end if
  tmp.add(level)
  prop = symbol(me.mergeListItemsIntoOne(tmp))
  return m_strings[prop]
end

on comesBeforeValInPropList me, argList, argProp
  argList.addProp(argProp, #FindThisProp)
  Pos = argList.findPos(argProp)
  argList.deleteProp(#FindThisProp)
  if Pos >= argList.count then
    Pos = argList.count - 1
  end if
  return argList[Pos + 1]
end

on mergeListItemsIntoOne me, argList
  str = EMPTY
  repeat with tmpItem in argList
    str = str & string(tmpItem)
  end repeat
  return str
end
