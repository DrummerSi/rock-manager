property test

on new me
  test = 0
  me.xxxrparseTest()
  return me
end

on xxxrparseTest me, argExpressionStr
  m_parseAndCalcObj = script("CalcParsedExpressionScript").new()
  argExpressionStr = "me.test = 10"
  parsed = m_parseAndCalcObj.parseExpression(argExpressionStr)
  m_parseAndCalcObj.calc(parsed, VOID, VOID, me)
  parsed = m_parseAndCalcObj.parseExpression("me.test += 1")
  m_parseAndCalcObj.calc(parsed, VOID, VOID, me)
  pott(test)
  parsed = m_parseAndCalcObj.parseExpression("debug(me.test == 100)")
  m_parseAndCalcObj.calc(parsed, VOID, VOID, me)
end
