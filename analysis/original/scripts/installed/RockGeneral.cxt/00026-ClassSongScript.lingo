property ancestor, child, className, belongsTo, _killed, StyleMix, Genre, PriceModel, quality, SongType, loops, MixerDefault, BPM, TimeSignature, numBars

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  ancestor = script("ClassConcreteScript").new(child)
  className = #Song
  StyleMix = script("ClassStyleMixScript").new(VOID, me)
  Genre = EMPTY
  PriceModel = script("ClassPriceModelScript").new(VOID, me)
  quality = 0.0
  SongType = 0.0
  loops = []
  MixerDefault = #none
  BPM = 0.0
  TimeSignature = []
  numBars = 0
  return me
end

on kill me
  _killed = 1
  if objectp(StyleMix) then
    StyleMix = StyleMix.kill()
  end if
  if objectp(PriceModel) then
    PriceModel = PriceModel.kill()
  end if
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end
