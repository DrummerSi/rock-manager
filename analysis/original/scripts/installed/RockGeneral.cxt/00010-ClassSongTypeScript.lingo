property ancestor, child, className, belongsTo, _killed, Hit, Alternative

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  className = #SongType
  Hit = 0.0
  Alternative = 0.0
  return me
end

on kill me
  _killed = 1
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end
