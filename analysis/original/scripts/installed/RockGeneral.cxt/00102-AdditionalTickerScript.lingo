property m_callBackInfo, m_timerObj

on new me, argTimerObj, argPrio, argWhen, argCallBackInfo
  m_timerObj = argTimerObj
  m_callBackInfo = argCallBackInfo
  m_timerObj.addObject(me, argPrio, argWhen)
  return me
end

on kill me
  m_timerObj.deleteObject(me)
  m_callBackInfo = 0
  return 0
end

on timeTick me
  if objectp(m_callBackInfo[#object]) then
    tmpHandler = m_callBackInfo[#handler]
    if voidp(tmpHandler) then
      tmpHandler = #callback
    end if
    call(tmpHandler, m_callBackInfo[#object])
  end if
end
