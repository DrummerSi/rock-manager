property ancestor, child, className, belongsTo, _killed, quality, Producer, AvailableFX, price, StudioMusicians, NumChannels

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  ancestor = script("ClassPlaceScript").new(child)
  className = #Studio
  quality = 0.0
  Producer = #none
  AvailableFX = []
  price = 0
  StudioMusicians = []
  NumChannels = 0
  return me
end

on kill me
  _killed = 1
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end
