property ancestor, child, className, belongsTo, _killed, eventCardID
global gRock

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  ancestor = script("ClassAudienceExposureScript").new(child)
  className = #ExpoMediaActivity
  eventCardID = #none
  return me
end

on kill me
  _killed = 1
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end

on eventChangeState me, argAction, argOption
  band_r = gRock.m_context.getFocus(#Band)
  if band_r.getIsInTown() = 0 then
    pott("Media should get angry because interview was cancelled!")
    return 0
  end if
  if argAction = #start then
    media_r = gRock.m_classManager.getObjByIDAndClass(ancestor.MediaID, #media)
    if not objectp(media_r) then
      pott("No media set!")
      return 0
    end if
    reporter_r = media_r.getReporter()
    reporter_r.checkMediaActivity(me)
    ancestor.stdFillInBlanks()
  else
    if argAction = #stop then
      if eventCardID <> #none then
        HumanID = VOID
        musician_r = gRock.m_context.getFocus(#RealMusicianVocals)
        HumanID = musician_r.ID
        media_r = gRock.m_classManager.getObjByIDAndClass(ancestor.MediaID, #media)
        if objectp(media_r) then
        end if
        gRock.m_eventCardsManager.tryNewShowEventCard(eventCardID, [#EventCardOptions: [#HumanID: HumanID]])
      end if
    end if
  end if
  return ancestor.eventChangeState(argAction, argOption)
end
