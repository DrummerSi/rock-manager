property ancestor, child, className, belongsTo, _killed, file, LoopType, Instrument, StyleMix, BelongsToSong, Groove, Difficulty, numBars, BPM

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  ancestor = script("ClassConcreteScript").new(child)
  className = #loop
  file = EMPTY
  LoopType = #none
  Instrument = #none
  StyleMix = script("ClassStyleMixScript").new(VOID, me)
  BelongsToSong = #none
  Groove = #none
  Difficulty = 0.0
  numBars = 0
  BPM = 0.0
  return me
end

on kill me
  _killed = 1
  if objectp(StyleMix) then
    StyleMix = StyleMix.kill()
  end if
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end
