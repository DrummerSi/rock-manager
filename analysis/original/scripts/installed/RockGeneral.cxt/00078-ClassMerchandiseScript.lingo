property ancestor, child, className, belongsTo, _killed, DesignCost, PriceLevel, Revenue, CompositeInfo

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  ancestor = script("ClassConcreteScript").new(child)
  className = #Merchandise
  DesignCost = 0
  PriceLevel = 0.0
  Revenue = 0
  CompositeInfo = []
  return me
end

on kill me
  _killed = 1
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end
