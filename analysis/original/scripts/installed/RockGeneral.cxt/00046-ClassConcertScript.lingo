property ancestor, child, className, belongsTo, _killed, Venue, PriceModel, NumAudience, quality, Income, VenueIncome, BandPerformance, calcedList, sndObj
global gRock

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  ancestor = script("ClassEventScript").new(child)
  className = #Concert
  Venue = #none
  PriceModel = script("ClassPriceModelScript").new(VOID, me)
  NumAudience = 0
  quality = 0.0
  Income = 0
  VenueIncome = 0
  BandPerformance = 0.0
  return me
end

on kill me
  _killed = 1
  if objectp(PriceModel) then
    PriceModel = PriceModel.kill()
  end if
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  if objectp(sndObj) then
    sndObj = sndObj.kill()
  end if
  return 0
end

on getRating me
  return convValToRange(quality, [0, 1], [0, 10]) / 2.0
end

on eventChangeState me, argAction, argOption
  global gRock
  if argAction = #start then
    album_r = gRock.m_context.getFocus(#album)
    if not objectp(album_r) then
      gRock.m_eventCardsManager.tryNewShowEventCard(#ECOCConcertCancelNoAlbum)
      me.kill()
      return #DontStart
    end if
    gRock.m_context.setFocus(#Concert, me)
  else
    if argAction = #stop then
      gRock.m_context.setFocus(#Concert, me)
      album_r = gRock.m_context.getFocus(#album)
      if not objectp(album_r) then
        alert("No album!")
        exit
        albums_r = gRock.m_classManager.getObjsOfClass(#album)
        if albums_r.count = 0 then
        else
          tmpSortedByRelease = [:]
          tmpSortedByRelease.sort()
          repeat with album_r in albums_r
            tmpSortedByRelease.addProp(album_r.ReleaseDate, album_r)
          end repeat
          album_r = tmpSortedByRelease[tmpSortedByRelease.count]
        end if
      end if
      venue_r = gRock.m_classManager.getObjByIDAndClass(Venue, #place)
      if not objectp(venue_r) then
        alert("Error in concert's venue!")
        exit
      end if
      tmpReachesGroups = venue_r.calcReach()
      tmpRegularVisitors = venue_r.size * venue_r.Regulars
      calcedList = calcAudienceSatisfaction([#VenueSize: venue_r.size, #ReachesGroups: tmpReachesGroups, #PopulationFactor: 1.0, #GuaranteedVisitors: tmpRegularVisitors, #IsTour: 0])
      if calcedList[#Cancelled] = 1 then
        gRock.m_eventCardsManager.tryNewShowEventCard(#ECOCBandIncomplete)
      else
        NumAudience = calcedList[#NumAudience]
        BandPerformance = calcedList[#Performance]
        quality = calcedList[#Satisfaction]
        if quality < 0 then
          quality = 0
        end if
        VenueIncome = NumAudience * venue_r.PreferredPriceModel.UnitPrice
        Income = VenueIncome * venue_r.PreferredPriceModel.Royalty
        calcedList.addProp(#VenueID, venue_r.ID)
        calcedList.addProp(#ConcertID, ancestor.ID)
        reporters_r = gRock.m_classManager.getObjsOfClass(#Reporter)
        repeat with reporter_r in reporters_r
          if reporter_r.gotTicketsForConcert(ancestor.ID) then
            reporter_r.checkWillReviewConcert(me)
          end if
        end repeat
        gRock.m_context.setFocus(#Concert, me)
        gRock.m_eventCardsManager.tryNewShowEventCard(VOID, [#DlgScript: #ConcertResult, #prio: #PrioConcertResult, #ConcertInfo: calcedList])
      end if
    end if
  end if
  return ancestor.eventChangeState(argAction, argOption)
end

on stopSound me
  if objectp(sndObj) then
    sndObj = sndObj.kill()
  end if
end

on fadeSound me
  if objectp(sndObj) then
    sndObj.fade(#Out, 2000)
  end if
end
