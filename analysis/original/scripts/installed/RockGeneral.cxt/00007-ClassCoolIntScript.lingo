property ancestor, child, className, belongsTo, _killed, val

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  ancestor = script("ClassCoolVarScript").new(child)
  className = #CoolInt
  val = 0
  return me
end

on kill me
  _killed = 1
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end

on add me, argVal
  val = val + argVal
  ancestor.notifyThem(#add)
end

on sub me, argVal
  val = val - argVal
  ancestor.notifyThem(#sub)
end

on setOneProp me, arg, argVal
  val = argVal
  ancestor.notifyThem(#set)
end
