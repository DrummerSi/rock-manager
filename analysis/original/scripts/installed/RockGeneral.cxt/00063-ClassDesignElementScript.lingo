property ancestor, child, className, belongsTo, _killed, Style, price, quality

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  ancestor = script("ClassConcreteScript").new(child)
  className = #DesignElement
  Style = script("ClassStyleMixScript").new(VOID, me)
  price = 0
  quality = 0.0
  return me
end

on kill me
  _killed = 1
  if objectp(Style) then
    Style = Style.kill()
  end if
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end
