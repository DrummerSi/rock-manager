property ancestor, child, className, belongsTo, _killed, Guitar, Bass, Keyboards, Drums, Vocals, Wind

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  className = #InstrumentGFX
  Guitar = EMPTY
  Bass = EMPTY
  Keyboards = EMPTY
  Drums = EMPTY
  Vocals = EMPTY
  Wind = EMPTY
  return me
end

on kill me
  _killed = 1
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end
