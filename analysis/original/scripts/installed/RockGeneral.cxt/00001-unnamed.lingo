global gUseful, gDir, gMembers, gRock, gSystem, gSwitches

on prepareMovie
  tmpCP = the number of member "   __!orpZxzx!"
  if not objectp(gSystem) then
    gSystem = script("SystemScript").new()
  end if
  if not objectp(gUseful) then
    if stringp(getSystemPref([#SavePotts, #path])) then
      writeFile(getSystemPref([#SavePotts, #path]), EMPTY)
    end if
    polandPott("Preparemovie")
    gUseful = new(script("UsefulScript"))
    polandPott("gUseful newed")
    gUseful.init()
    polandPott("inited")
  end if
  gUseful.prepareMovie()
  polandPott("prepared")
  if not objectp(gSwitches) then
    tmpPaths = script("PathsScript").new()
    tmpDeclarationsFile = "ClassPropsSwitches.txt"
    tmpPath = tmpPaths.findFileInOneOfPaths(tmpDeclarationsFile, #data)
    gSwitches = script("ImportSwitchesScript").new(tmpPath)
  end if
  polandPott("gSwitches/Paths newed")
  if not objectp(gRock) then
    gRock = script("RockScript").new()
    gRock.init()
  end if
  gRock.prepareMovie()
  gDir = script("Dir").new()
  gRock.DirNewed()
  if objectp(gDir) then
    gDir.init()
  end if
  gRock.DirInited()
end

on startMovie
  gUseful.startMovie()
  if objectp(gDir) then
    gDir.startMovie()
  end if
end

on testPrepareMovie
  tmpCP = the number of member "   __!orpZxzx!"
  if not objectp(gSystem) then
    gSystem = script("SystemScript").new()
  end if
  if not objectp(gUseful) then
    gUseful = script("UsefulScript").new()
    gUseful.init()
  end if
  gUseful.prepareMovie()
  if not objectp(gSwitches) then
    gSwitches = script("ImportSwitchesScript").new()
  end if
  if not objectp(gRock) then
    gRock = script("RockScript").new()
    gRock.init()
  end if
  gRock.prepareMovie()
end

on stopMovie
  gUseful.stopMovie()
  gRock.stopMovie()
  if objectp(gDir) then
    gDir = gDir.kill()
  end if
end

on ccc
  if objectp(gRock) then
    gRock = gRock.kill()
  end if
  if objectp(gSystem) then
    gSystem = gSystem.kill()
  end if
  if objectp(gSwitches) then
    gSwitches = gSwitches.kill()
  end if
  if objectp(gUseful) then
    gUseful = gUseful.kill()
  end if
  clearGlobals()
end

on zzz
  if objectp(gUseful) then
    gUseful = gUseful.kill()
  end if
  if objectp(gRock) then
    gRock.m_textFormatter.kill()
    gRock.m_textFormatter = script("TextFormatterScript").new()
    gRock.m_agenda.kill()
    gRock.m_agenda = script("AgendaScript").new()
  end if
end

on xxxInit
  ccc()
  prepareMovie()
end

on idle
  if objectp(gUseful) then
    gUseful.idle()
  end if
end
