property m_agenda, m_image, m_viewRect, m_blitOffset

on new me, argMasterObj
  m_agenda = argMasterObj
  return me
end

on kill me
  return 0
end

on setViewRect me, argRect
  m_viewRect = argRect
  size = getRectSize(m_viewRect)
  m_blitOffset = point(m_viewRect[1], m_viewRect[2])
  m_image = image(size[1], 1, 8)
end

on scroll me, argPoint
  imageMoveWithin(m_image, -argPoint, m_image.rect, m_image.rect)
end

on draw me, argStartAndEndDates, argRect
  m_image.fill(argRect, rgb(255, 255, 255))
  if m_agenda.m_pixelsPerDay <= 1 then
  else
    if m_agenda.m_pixelsPerDay <= 4 then
    end if
  end if
  repeat with dayNr = integer(m_agenda.m_datesViewRange[1]) to integer(m_agenda.m_datesViewRange[2])
    locH = m_agenda.dateToLocH(dayNr)
    m_image.setPixel(locH, 0, rgb(50, 50, 50))
  end repeat
  m_agenda.m_imagePtr[1].copyPixels(m_image, m_agenda.m_viewRect + rect(0, 0, 0, -50), m_image.rect, [#ink: 36])
end
