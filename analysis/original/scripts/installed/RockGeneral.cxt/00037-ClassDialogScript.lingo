property ancestor, child, className, belongsTo, _killed, dataMemberName, loc, icon, ButtonOK, ButtonCancel, Button3, Actions, PreExecuteThis, ExecuteThis

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  ancestor = script("ClassConcreteScript").new(child)
  className = #Dialog
  dataMemberName = EMPTY
  loc = point(0, 0)
  icon = EMPTY
  ButtonOK = script("ClassbuttonScript").new(VOID, me)
  ButtonCancel = script("ClassbuttonScript").new(VOID, me)
  Button3 = script("ClassbuttonScript").new(VOID, me)
  Actions = []
  PreExecuteThis = EMPTY
  ExecuteThis = EMPTY
  return me
end

on kill me
  _killed = 1
  if objectp(ButtonOK) then
    ButtonOK = ButtonOK.kill()
  end if
  if objectp(ButtonCancel) then
    ButtonCancel = ButtonCancel.kill()
  end if
  if objectp(Button3) then
    Button3 = Button3.kill()
  end if
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end

on init me
  if offset("OKCancel", child.script) then
    pott("LK")
  end if
end
