property ancestor, child, className, belongsTo, _killed, Guitar, Bass, Keyboards, Drums, Vocals

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  className = #InstrumentalSkills
  Guitar = 0
  Bass = 0
  Keyboards = 0
  Drums = 0
  Vocals = 0
  return me
end

on kill me
  _killed = 1
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end
