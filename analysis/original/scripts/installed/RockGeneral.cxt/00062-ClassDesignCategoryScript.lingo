property ancestor, child, className, belongsTo, _killed, elements
global gRock

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  ancestor = script("ClassConcreteScript").new(child)
  className = #DesignCategory
  elements = []
  return me
end

on kill me
  _killed = 1
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end

on getElementObjByNr me, argNr
  if (argNr < 1) or (argNr > elements.count()) then
    return VOID
  end if
  tmpID = elements[argNr]
  return gRock.m_classManager.getObjByIDAndClass(tmpID, #DesignElement)
end
