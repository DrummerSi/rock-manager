property m_SP, m_nowOverList, m_waitUntil, m_active
global gRock, gUseful

on new me
  global gDir
  m_SP = sprite(gDir.m_spriteList[#rollover])
  m_nowOverList = []
  gUseful.frameTimer.addObject(me)
  m_waitUntil = 0
  m_active = 1
  return me
end

on kill me
  gUseful.frameTimer.deleteObject(me)
  me.show(0)
  return 0
end

on getInfoStr me, argObj_r
  str = gRock.m_languageManager.getStr(symbol("szIdClass" & string(argObj_r.className)), [#FirstUppercase: 1])
  str = str & ", " & rGetDateStr(argObj_r.StartDate)
  strList = []
  if argObj_r.className = #Concert then
    strList[1] = str
    str = str & RETURN
    place_r = gRock.m_classManager.getObjByIDAndClass(argObj_r.Venue, #Live)
    str = str & place_r.name
  else
    if argObj_r.className = #ExpoAd then
      str = str & ", " & string(argObj_r.duration) & " "
      if argObj_r.duration > 1 then
        str = str & gRock.m_languageManager.getStr(#szidDay_P)
      else
        str = str & gRock.m_languageManager.getStr(#szidDay_S)
      end if
      place_r = gRock.m_classManager.getObjByIDAndClass(argObj_r.media, #media)
      str = str & place_r.name & ", " & argObj_r.name
    else
      if argObj_r.className = #Interview then
        str = str & RETURN
        place_r = gRock.m_classManager.getObjByIDAndClass(argObj_r.media, #media)
        str = str & " - " & rGetDateStr(argObj_r.StartDate + argObj_r.duration - 1) & RETURN
      else
        if argObj_r.className = #AlbumRelease then
        else
          if argObj_r.className = #VideoProduction then
          else
            if argObj_r.className = #BandTour then
            else
              if argObj_r.className = #Training then
              end if
            end if
          end if
        end if
      end if
    end if
  end if
  return str
end

on activate me, argIsTRUE
  m_active = argIsTRUE
  if m_active = 0 then
    me.show(0)
    m_waitUntil = 0
    m_nowOverList = []
  end if
end

on Report me, argObj, argWhat, argOptions
  if argWhat = #enter then
    if not m_active then
      exit
    end if
    m_nowOverList.add(argOptions)
    m_waitUntil = the milliSeconds + (0.59999999999999998 * 1000)
  else
    if argWhat = #Leave then
      if not m_active then
        exit
      end if
      m_nowOverList.deleteOne(argOptions)
      if m_nowOverList.count > 0 then
        m_waitUntil = the milliSeconds + (0.59999999999999998 * 1000)
      else
        m_waitUntil = 0
      end if
      me.show(0)
    end if
  end if
end

on timeTick me
  if (m_waitUntil > 0) and (the milliSeconds > m_waitUntil) then
    m_waitUntil = 0
    me.show(m_nowOverList[m_nowOverList.count])
  end if
end

on show me, argObj
  if objectp(argObj) then
    str = me.getInfoStr(argObj)
    memb = member("RollOverAgendaText")
    memb.text = str
    m_SP.member = memb
    width = memb.rect[3]
    tmp = getRectSize((the stage).rect)
    if (the mouseH + width) > tmp[1] then
      m_SP.loc = the mouseLoc + point(-width, -memb.rect[4])
    else
      m_SP.loc = the mouseLoc + point(0, -memb.rect[4])
    end if
    m_SP.ink = 0
  else
    m_SP.member = member("Dummy")
    m_SP.ink = 36
  end if
end
