property ancestor, child, className, belongsTo, _killed, MrCP

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  ancestor = script("ClassNeedScript").new(child)
  className = #NeedParty
  MrCP = 0
  ancestor.DynamicTrigger.max = 1.0
  ancestor.DynamicTrigger.min = -1.0
  ancestor.DynamicTrigger.GainFact = 0.10000000000000001
  ancestor.DynamicTrigger.LoseFact = 0
  ancestor.DynamicTrigger.ValTriggers = [0.05: 0, 0.59999999999999998: 1, 0.75: 2, 1.10000000000000009: 3]
  ancestor.DynamicTrigger.mode = #AutoXGain
  ancestor.satisfyChanges = [#Health: -0.29999999999999999, #Patience: 0.20000000000000001]
  ancestor.highNeedChanges = [#Mood: -0.10000000000000001]
  ancestor.NegativeNeedChanges = [:]
  ancestor.affectLimit = 0.20000000000000001
  return me
end

on kill me
  _killed = 1
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end
