property ancestor, child, className, belongsTo, _killed, question, AltText1, AltText2, AltText3

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  ancestor = script("ClassEventCardScript").new(child)
  className = #EventCardMulti
  question = EMPTY
  AltText1 = EMPTY
  AltText2 = EMPTY
  AltText3 = EMPTY
  return me
end

on kill me
  _killed = 1
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end
