property ancestor, child, className, belongsTo, _killed, ID, name, Gfx, clr, UsedByClass

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  className = #AgendaEventFormat
  ID = #none
  name = EMPTY
  Gfx = EMPTY
  clr = EMPTY
  UsedByClass = #none
  return me
end

on kill me
  _killed = 1
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end
