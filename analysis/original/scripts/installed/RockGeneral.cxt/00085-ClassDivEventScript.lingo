property ancestor, child, className, belongsTo, _killed, AgendaFormat, AutoEventCard
global gRock

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  ancestor = script("ClassEventScript").new(child)
  className = #DivEvent
  AgendaFormat = #none
  AutoEventCard = 0
  return me
end

on kill me
  _killed = 1
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end

on eventChangeState me, argAction, argOption
  if argAction = #start then
  else
    if argAction = #stop then
      if AutoEventCard = 1 then
      else
        if symbolp(AutoEventCard) then
          if ancestor.neededIDs.count then
            tmpHumanID = ancestor.neededIDs[1]
          else
            tmpHumanID = VOID
          end if
          gRock.m_eventCardsManager.tryNewShowEventCard(AutoEventCard, [#prio: 3, #EventCardOptions: [#HumanID: tmpHumanID]])
        end if
      end if
    end if
  end if
  return ancestor.eventChangeState(argAction, argOption)
end
