property ancestor, child, className, belongsTo, _killed, ID, MediaID, LikeThreshold, Chance, type, Threshold, Viewers, ResultGood, ResultBad

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  className = #MediaActivity
  ID = #none
  MediaID = #none
  LikeThreshold = 0.0
  Chance = 0
  type = EMPTY
  Threshold = 0.0
  Viewers = 0.0
  ResultGood = script("ClassMediaActivityResultScript").new(VOID, me)
  ResultBad = script("ClassMediaActivityResultScript").new(VOID, me)
  return me
end

on kill me
  _killed = 1
  if objectp(ResultGood) then
    ResultGood = ResultGood.kill()
  end if
  if objectp(ResultBad) then
    ResultBad = ResultBad.kill()
  end if
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end
