property m_dlgSize, m_displaySize, m_channelObjs, m_datesViewRange, m_orgDatesViewRange, m_pixelsPerDay, m_showNumDays, m_datePlotter, m_dlg, m_imagePtr, m_viewRect, m_viewRectOnStage, m_spriteList, m_todayDate, m_frameShrinkRect, m_clr, m_stdTextClr, m_bottomOffset, m_scrollBar, m_arrows, m_maxScrollNumDays, m_tmpMember, m_bgMember, m_bgMemberBlitOffRect, m_mouseLayer, m_arrowDownOnTime

on new me
  m_datesViewRange = [1, 0]
  m_datePlotter = script("DatePlotterScript").new(me)
  m_channelObjs = [:]
  m_clr = rgb(0, 0, 0)
  m_stdTextClr = rgb(120, 120, 120)
  return me
end

on kill me
  if objectp(m_datePlotter) then
    m_datePlotter = m_datePlotter.kill()
  end if
  if objectp(m_dlg) then
    m_dlg = m_dlg.kill()
  end if
  return 0
end

on cleanUp me
end

on load me, argList
  tmp = argList[#channels]
  repeat with obj in m_channelObjs
    obj.kill()
  end repeat
  m_channelObjs = [:]
  repeat with n = 1 to tmp.count
    me.addChannel(tmp.getPropAt(n), tmp[n])
  end repeat
end

on save me
  return [:]
end

on setTodayDate me, argTodayDateInt
  m_todayDate = argTodayDateInt
  if voidp(m_todayDate) then
    m_todayDate = 20
  end if
end

on openDlg me, argRect, argSpriteList, argMidDate, argOptions
  if voidp(argSpriteList) then
    if voidp(m_spriteList) then
      argSpriteList = [#dlg: 55, #Drag: 150]
    else
      argSpriteList = m_spriteList
    end if
  end if
  m_spriteList = argSpriteList
  sprite(m_spriteList[#dlg]).ink = 36
  m_mouseLayer = (m_spriteList[#dlg] * 1000) + 30
  if voidp(argOptions) then
    argOptions = [:]
  end if
  m_frameShrinkRect = argOptions[#ShrinkRect]
  if not listp(m_frameShrinkRect) then
    m_frameShrinkRect = rect(0, 0, 0, 0)
  end if
  tmpBGPic = argOptions[#bgPic]
  if voidp(tmpBGPic) then
    tmpBGPic = "TmpLargeAgendaBG"
  end if
  m_bgMember = member(tmpBGPic)
  m_showNumDays = 17
  if voidp(argMidDate) then
    argMidDate = m_todayDate
  else
    if floatp(argMidDate) then
      argMidDate = m_todayDate + integer(m_showNumDays * argMidDate)
    end if
  end if
  m_datesViewRange = [argMidDate, argMidDate]
  argRect = loc2Rect(point(argRect[1], argRect[2])) + m_bgMember.rect
  m_dlgSize = getRectSize(argRect)
  m_viewRectOnStage = rect(point(0, 0), m_dlgSize) + m_frameShrinkRect + rect(argRect[1], argRect[2], argRect[1], argRect[2])
  m_displaySize = getRectSize(m_viewRectOnStage)
  m_viewRect = rect(point(0, 0), m_displaySize)
  tmp = m_displaySize[1] / m_showNumDays
  tmpRoundedWidth = tmp * m_showNumDays
  m_viewRect[3] = m_viewRect[3] + tmpRoundedWidth - m_displaySize[1]
  m_displaySize[1] = tmpRoundedWidth
  m_pixelsPerDay = float(m_displaySize[1]) / m_showNumDays
  m_tmpMember = newMember(#bitmap, "__TEMP", 1)
  sprite(m_spriteList[#dlg]).member = m_tmpMember
  sprite(m_spriteList[#dlg]).loc = point(m_viewRectOnStage[1], m_viewRectOnStage[2])
  m_imagePtr = [image(m_displaySize[1], m_displaySize[2], 16)]
  m_tmpMember.image = m_imagePtr[1]
  m_tmpMember.regPoint = point(0, 0)
  m_bgMemberBlitOffRect = rect(m_frameShrinkRect[1], m_frameShrinkRect[2], m_frameShrinkRect[1], m_frameShrinkRect[2])
  if 1 then
    SPNum = m_spriteList[#dlg] + 1
    m_arrows = []
    rectForScrollBar = rect(0, 0, 0, 0)
    rectForScrollControl = rect(argRect[1] + m_viewRect[1], argRect[4], argRect[1] + m_viewRect[1] + m_displaySize[1], argRect[4])
    rectForScrollControl = rectForScrollControl + rect(0, 20, 0, 20)
    memb = member("agenda_slider_arrows01Left")
    rectForScrollBar[1] = memb.width
    tmpLoc = point(rectForScrollControl[1], rectForScrollControl[4]) + point(memb.regPoint[1], 0)
    arrowObj = script("ButtonScript").new(me, memb, tmpLoc, SPNum, [#ID: #left, #layer: m_mouseLayer, #states: [#enter: 1, #dim: 2]])
    m_arrows.add(arrowObj)
    SPNum = SPNum + 1
    memb = member("agenda_slider_arrows01Right")
    rectForScrollBar[3] = -memb.width
    tmpLoc = point(rectForScrollControl[3], rectForScrollControl[4]) - point(memb.width - memb.regPoint[1], 0)
    arrowObj = script("ButtonScript").new(me, memb, tmpLoc, SPNum, [#ID: #right, #layer: m_mouseLayer, #states: [#enter: 1, #dim: 2]])
    m_arrows.add(arrowObj)
    SPNum = SPNum + 1
    sprite(SPNum).member = member("BehindScrollerPic")
    sprite(SPNum).rect = rectForScrollControl + rectForScrollBar + rect(5, -7, -5, 7)
    SPNum = SPNum + 1
    memb = member("agenda_slider_arrows01")
    tmpRect = rectForScrollControl + rectForScrollBar + rect(memb.regPoint[1], 0, -(memb.width - memb.regPoint[1]), 0)
    m_scrollBar = script("SliderScript").new(me, SPNum, memb, tmpRect, VOID, [#layer: m_mouseLayer])
    m_scrollBar.setFactor(0.5, #Gfx)
    SPNum = SPNum + 1
    m_maxScrollNumDays = 20
  end if
  me.resize(m_dlgSize, #center)
  m_orgDatesViewRange = m_datesViewRange.duplicate()
  me.draw()
end

on GetSPNeed me
  return 5
end

on closeDlg me
  if ilk(m_tmpMember) = #member then
    m_tmpMember.erase()
    m_tmpMember = 0
  end if
  if listp(m_arrows) then
    repeat with obj in m_arrows
      obj.kill()
    end repeat
    m_arrows = []
  end if
  repeat with n = me.GetSPNeed() down to 1
    SP = sprite(m_spriteList[#dlg] + n - 1)
    SP.member = member("Dummy")
    SP.stretch = 0
  end repeat
  if objectp(m_scrollBar) then
    m_scrollBar = m_scrollBar.kill()
  end if
  if objectp(m_dlg) then
    m_dlg = m_dlg.kill()
  end if
  repeat with obj in m_channelObjs
    obj.kill()
  end repeat
  m_channelObjs = [:]
  m_imagePtr = 0
end

on mouse me, argObj, argWhat, argOption
  if m_arrows.getPos(argObj) then
    if (argWhat = #down) or (argWhat = #stillDown) then
      if argWhat = #down then
        m_arrowDownOnTime = the milliSeconds
      else
        if (the milliSeconds - m_arrowDownOnTime) < 300 then
          exit
        end if
      end if
      if argObj.ID = #left then
        me.scroll(point(-m_pixelsPerDay * 2, 0))
      else
        if argObj.ID = #right then
          me.scroll(point(m_pixelsPerDay * 2, 0))
        end if
      end if
    end if
    exit
  end if
  if argWhat = #click then
    if objectp(argOption) then
      if argOption.ID = #close then
        me.kill()
      end if
    end if
  end if
end

on Report me, argObj, argWhat, argOption
  if argObj = m_scrollBar then
    if argWhat = #changed then
      currentOffset = m_datesViewRange[1] - m_orgDatesViewRange[1]
      scrollTo = ((argOption * 2.0) - 1.0) * m_maxScrollNumDays
      diff = scrollTo - currentOffset
      me.scroll(point(diff * float(m_pixelsPerDay), 0))
    end if
  end if
end

on resize me, argSize, argKeepDate
  if voidp(argKeepDate) then
    argKeepDate = #center
  end if
  startDay = m_datesViewRange[1]
  midDate = ((m_datesViewRange[2] - m_datesViewRange[1]) / 2) + m_datesViewRange[1]
  numDays = float(m_showNumDays)
  if argKeepDate = #left then
    m_datesViewRange = [startDay, startDay + numDays]
  else
    if argKeepDate = #center then
      m_datesViewRange = [midDate - ((numDays - 1) / 2.0), midDate + ((numDays - 1) / 2.0)]
    end if
  end if
  lastBottomV = 0
  m_datePlotter.setViewRect(rect(m_viewRect[1], lastBottomV, m_viewRect[3], 0))
  lastBottomV = m_datePlotter.getBottomV()
  repeat with n = 1 to m_channelObjs.count
    obj = m_channelObjs[n]
    obj.setViewRect(rect(point(m_viewRect[1], lastBottomV), point(m_viewRect[3], 0)))
    lastBottomV = obj.getBottomV() + 15
  end repeat
end

on expandedChannel me, argChannel
  me.resize()
  me.draw()
end

on addChannel me, argID, argInfo
  tmpScript = "Channel" & string(argInfo[#type]) & "Script"
  obj = script(tmpScript).new(me, 0, argInfo)
  m_channelObjs.addProp(argID, obj)
end

on dateToLocH me, argDate
  rangeDiff = 1 + m_datesViewRange[2] - m_datesViewRange[1]
  pix = m_displaySize[1] * (float(argDate) - m_datesViewRange[1]) / rangeDiff
  return pix
end

on locHtoDate me, argLocH, argRelTo
  if argRelTo = #Screen then
    argLocH = argLocH - m_viewRectOnStage[1]
  end if
  frac = float(argLocH) / m_displaySize[1]
  rangeDiff = m_datesViewRange[2] - m_datesViewRange[1]
  date = (frac * rangeDiff) + m_datesViewRange[1]
  return date
end

on isLocOverChannel me, argLoc
  argLoc = argLoc - point(m_viewRectOnStage[1], m_viewRectOnStage[2])
  repeat with n = 1 to m_channelObjs.count
    obj = m_channelObjs[n]
    if argLoc.inside(obj.m_viewRect) then
      return obj
    end if
  end repeat
end

on scroll me, argPoint
  argPoint[1] = integer(argPoint[1])
  numDays = float(argPoint[1]) / float(m_pixelsPerDay)
  newRange = m_datesViewRange + [numDays, numDays]
  realScrolled = m_pixelsPerDay * (newRange[1] - m_datesViewRange[1])
  m_datesViewRange = newRange
  if realScrolled = 0 then
    exit
  end if
  m_imagePtr[1].copyPixels(m_bgMember.image, m_imagePtr[1].rect, m_imagePtr[1].rect + m_bgMemberBlitOffRect)
  repeat with obj in m_channelObjs
    obj.scroll(point(realScrolled, 0))
  end repeat
  m_datePlotter.scroll(point(realScrolled, 0))
  if realScrolled < 0 then
    tmpR = rect(0, 0, -realScrolled, m_displaySize[2])
  else
    tmpR = rect(m_displaySize[1] - realScrolled, 0, m_displaySize[1], m_displaySize[2])
  end if
  currentOffset = m_datesViewRange[1] - m_orgDatesViewRange[1]
  fact = (float(currentOffset) / m_maxScrollNumDays / 2) + 0.5
  m_scrollBar.setFactor(fact, #Gfx)
  me.draw(tmpR, #DontCleanUp)
end

on draw me, argRect, argDontCleanUpFirst
  if voidp(argRect) then
    argRect = rect(point(0, 0), m_displaySize)
  end if
  argRect[4] = m_displaySize[2]
  if argDontCleanUpFirst <> #DontCleanUp then
    m_imagePtr[1].copyPixels(m_bgMember.image, m_imagePtr[1].rect, m_imagePtr[1].rect + m_bgMemberBlitOffRect)
  end if
  repeat with n = 1 to m_channelObjs.count
    obj = m_channelObjs[n]
    obj.draw(m_datesViewRange, argRect)
  end repeat
  m_datePlotter.draw(m_datesViewRange, argRect)
  todayLocH = me.dateToLocH(m_todayDate)
  DstRect = m_viewRect.duplicate()
  DstRect[3] = DstRect[1]
  DstRect = DstRect + rect(todayLocH, 15, todayLocH + m_pixelsPerDay, 0)
  DstRect = DstRect.intersect(m_viewRect)
  img = image(2, 2, 8)
  img.fill(rect(0, 0, 2, 2), rgb(255, 0, 0))
  m_imagePtr[1].copyPixels(img, DstRect, img.rect, [#ink: 32, #blend: 25])
  m_tmpMember.image = m_imagePtr[1]
  m_tmpMember.regPoint = point(0, 0)
end

on getPlannedEvent me, argID
  repeat with obj in m_channelObjs
    if obj.m_type = #Planning then
      repeat with plannedObj in obj.m_events
        event_r = plannedObj.m_event_r
        if event_r.ID = argID then
          return plannedObj
        end if
      end repeat
    end if
  end repeat
  return VOID
end
