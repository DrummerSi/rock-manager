property ancestor, child, className, belongsTo, _killed, Tour, City, NumAudience, quality, Income, VenueIncome, BandPerformance
global gRock

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  ancestor = script("ClassEventScript").new(child)
  className = #TourConcert
  Tour = #none
  City = #none
  NumAudience = 0
  quality = 0.0
  Income = 0
  VenueIncome = 0
  BandPerformance = 0.0
  return me
end

on kill me
  _killed = 1
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end

on getRating me
  return convValToRange(quality, [0, 1], [0, 10]) / 2.0
end

on eventChangeState me, argAction, argOption
  global gRock
  if argAction = #start then
    gRock.m_context.setFocus(#TourConcert, me)
  else
    if argAction = #stop then
      city_r = gRock.m_classManager.getObjByIDAndClass(City, #TourCity)
      if not objectp(city_r) then
        alert("Error in concert's city!")
        return 0
      end if
      tour_r = gRock.m_classManager.getObjByIDAndClass(Tour, #BandTour)
      tmpSatisfactionChange = 0.20000000000000001 * tour_r.StageQuality
      tmpReachesGroups = city_r.calcReach()
      tmpRegularVisitors = 0
      calcedList = calcAudienceSatisfaction([#VenueSize: city_r.size, #ReachesGroups: tmpReachesGroups, #PopulationFactor: city_r.PopulationFactor, #GuaranteedVisitors: tmpRegularVisitors, #AddToSatisfaction: tmpSatisfactionChange, #IsTour: 1])
      pott("TourConc", calcedList)
      NumAudience = calcedList[#NumAudience]
      BandPerformance = calcedList[#Performance]
      quality = calcedList[#Satisfaction]
      if quality < 0 then
        quality = 0
      end if
      VenueIncome = NumAudience * city_r.PreferredPriceModel.UnitPrice
      Income = VenueIncome * city_r.PreferredPriceModel.Royalty
      calcedList.addProp(#VenueID, city_r.ID)
      calcedList.addProp(#ConcertID, ancestor.ID)
      gRock.m_eventCardsManager.tryNewShowEventCard(VOID, [#prio: 0, #DlgScript: #TourConcertResult, #ConcertInfo: calcedList])
    end if
  end if
  return ancestor.eventChangeState(argAction, argOption)
end
