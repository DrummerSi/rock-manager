property ancestor, child, className, belongsTo, _killed, ID, LoopID, vol, FX, Mute, Pan

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  className = #channel
  ID = #none
  LoopID = #none
  vol = 0.0
  FX = []
  Mute = 0
  Pan = 0.0
  return me
end

on kill me
  _killed = 1
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end
