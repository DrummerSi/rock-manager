property ancestor, child, className, belongsTo, _killed, ID, comment, name, Gfx, WordUserM, WordUserF, WordVitalPart, WordVitalPartUser, PossibleSpatialPos, DesignEditorInfix

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  className = #InstrumentInfo
  ID = #none
  comment = EMPTY
  name = EMPTY
  Gfx = EMPTY
  WordUserM = EMPTY
  WordUserF = EMPTY
  WordVitalPart = EMPTY
  WordVitalPartUser = EMPTY
  PossibleSpatialPos = []
  DesignEditorInfix = EMPTY
  return me
end

on kill me
  _killed = 1
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end
