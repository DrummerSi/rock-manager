property ancestor, child, className, belongsTo, _killed, Metal, rock, Punk, Pop, Dance, Boring

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  className = #StyleMix
  Metal = 0
  rock = 0
  Punk = 0
  Pop = 0
  Dance = 0
  Boring = 0
  return me
end

on kill me
  _killed = 1
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end
