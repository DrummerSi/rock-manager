on rDefLikesAlbum argWho_r, argAlbum_r, argCheckWhat, argReturnWhat
  global gRock
  if voidp(argAlbum_r) then
    argAlbum_r = gRock.m_context.getFocus(#album)
  end if
  if voidp(argAlbum_r) then
    return VOID
  end if
  if voidp(argCheckWhat) then
    argCheckWhat = [#music: 1, #image: 1, #SongType: 1, #quality: 1]
  end if
  MediaTargets = rgetProp(argWho_r, #MediaTargets)
  if listp(MediaTargets) then
    if MediaTargets.count = 0 then
      alert("No mediaTargets defined!")
    else
      targetsLikeSorted = [:]
      targetsLikeSorted.sort()
      repeat with n = 1 to MediaTargets.count
        target_r = gRock.m_classManager.getObjByIDAndClass(MediaTargets[n], #MediaTarget)
        tmpInfo = rDefLikesAlbum(target_r, argAlbum_r, argCheckWhat, #ExtraInfo)
        targetsLikeSorted.addProp(tmpInfo[#Like], tmpInfo)
      end repeat
      tmpLikesBestInfo = targetsLikeSorted[targetsLikeSorted.count]
      tmpLikesBestInfo.addProp(#target, target_r)
      if argReturnWhat = #ExtraInfo then
        return tmpLikesBestInfo
      end if
      return tmpLikesBestInfo[#Like]
    end if
  end if
  otherInfo = [:]
  allWeights = [:]
  likesSorted = [:]
  likesSorted.sort()
  tmpStyleWeights = [:]
  if not voidp(argCheckWhat[#music]) then
    tmpStyleWeights.addProp(argCheckWhat[#music], argAlbum_r.MusicStyle)
  end if
  if not voidp(argCheckWhat[#image]) then
    tmpStyleWeights.addProp(argCheckWhat[#image], argAlbum_r.ImageStyle)
  end if
  if tmpStyleWeights.count then
    StyleObj = gRock.m_classManager.createUnregObj(#StyleMix)
    rCalcObjsAverage(StyleObj, tmpStyleWeights)
    weight = 0.0
    repeat with n = 1 to tmpStyleWeights.count
      weight = weight + tmpStyleWeights.getPropAt(n)
    end repeat
    weight = weight / tmpStyleWeights.count
    musicCenterVals = rgetProp(argWho_r, #MusicStyle)
    if objectp(musicCenterVals) then
      musicTolerance = rgetProp(argWho_r, #MusicStyleTolerance)
    else
      musicCenterVals = rgetProp(argWho_r, #StyleMix)
      musicTolerance = rgetProp(argWho_r, #StyleMixTolerance)
    end if
    if objectp(musicCenterVals) and objectp(musicTolerance) then
      tmpInfo = checkWithinTolerance(musicCenterVals, musicTolerance, StyleObj, #ExtraInfo)
      tmpLikeStyle = tmpInfo[#Like]
      tmp = tmpInfo[#LikeSorted]
      repeat with n = 1 to tmp.count
        likesSorted.addProp(tmp.getPropAt(n), mergeLists([#StyleMix], tmp[n]))
      end repeat
      otherInfo.addProp(#StyleMixSorted, tmpInfo[#LikeSorted])
      likesSorted.addProp(tmpLikeStyle, [#StyleMixTotal])
    end if
    if not voidp(tmpLikeStyle) then
      allWeights.addProp(weight, tmpLikeStyle)
    end if
    gRock.m_classManager.removeObj(StyleObj)
  end if
  weight = argCheckWhat[#SongType]
  if weight > 0 then
    typeCenterVals = rgetProp(argWho_r, #SongType)
    if not voidp(typeCenterVals) then
      typeTolerance = rgetProp(argWho_r, #SongTypeTolerance)
    else
    end if
    if not voidp(typeCenterVals) and not voidp(typeTolerance) then
      tmpInfo = checkWithinTolerance(typeCenterVals, typeTolerance, argAlbum_r.SongType, #ExtraInfo)
      tmpLikeType = tmpInfo[#Like]
      if tmpLikeType <> #ignore then
        likesSorted.addProp(tmpLikeType, [#SongType, tmpInfo[#why]])
      end if
    end if
    if not voidp(tmpLikeType) and (tmpLikeType <> #ignore) then
      allWeights.addProp(weight, tmpLikeType)
    end if
  end if
  weight = argCheckWhat[#quality]
  if weight > 0 then
    MinQuality = rgetProp(argWho_r, #MinQuality)
    if voidp(MinQuality) then
      MinQuality = 0
    end if
    qualityDiff = argAlbum_r.quality - MinQuality
    if qualityDiff >= 0 then
      tmpLikeQuality = funcNeverReach1(qualityDiff, 0.10000000000000001)
    else
      tmpLikeQuality = qualityDiff * 2.0
    end if
    likesSorted.addProp(tmpLikeQuality, [#quality])
    allWeights.addProp(weight, tmpLikeQuality)
  end if
  if 0 then
    repeat with n = allWeights.count down to 1
      val = allWeights[n]
      if val < 0 then
        weight = allWeights.getPropAt(n) * 10
        allWeights.deleteAt(n)
        allWeights.addProp(weight, val)
      end if
    end repeat
  end if
  likeTotal = calcAverage(allWeights)
  totalSubZero = 0.0
  repeat with n = 1 to likesSorted.count
    if likesSorted.getPropAt(n) < 0 then
      totalSubZero = totalSubZero + likesSorted.getPropAt(n)
      next repeat
    end if
    exit repeat
  end repeat
  if not voidp(argCheckWhat[#LiveReputation]) then
    MinLiveReputation = rgetProp(argWho_r, #MinLiveReputation)
    if not voidp(MinLiveReputation) then
      band_r = gRock.m_context.getFocus(#Band)
      diff = band_r.LiveReputation - MinLiveReputation
      likeTotal = likeTotal + (diff * argCheckWhat[#LiveReputation])
      otherInfo[#LiveReputation] = diff * argCheckWhat[#LiveReputation]
    end if
  end if
  freshEffect = 0.0
  if not voidp(argCheckWhat[#Freshness]) and (argCheckWhat[#Freshness] <> 0) then
    freshEffect = argCheckWhat[#Freshness] * (argAlbum_r.Freshness - 1.0)
    likeTotal = likeTotal + freshEffect
    otherInfo[#Freshness] = freshEffect
  end if
  mission_r = gRock.m_context.getFocus(#Mission)
  boost = mission_r.Vars.getaProp(#AlbumLikeBoost)
  if not voidp(boost) then
    likeTotal = 1.0
    if likeTotal > 1 then
      likeTotal = 1.0
    end if
    totalSubZero = 0
    newLikesSorted = [:]
    repeat with n = 1 to likesSorted.count
      newLikesSorted.addProp(1.0, likesSorted[n])
    end repeat
    likesSorted = newLikesSorted
  end if
  tmpExtraInfo = [#Like: likeTotal, #LikeSorted: likesSorted, #totalSubZero: totalSubZero, #WeightedList: allWeights, #Other: otherInfo]
  if rOKCheatPass() then
    tuneDebug("rDefLikesAlbum", argWho_r.ID, tmpExtraInfo)
  end if
  if argReturnWhat = #ExtraInfo then
    return tmpExtraInfo
  end if
  return likeTotal
end
