property ancestor, child, className, belongsTo, _killed, ID, comment, name, Gfx, Link, ExecuteThis

on new me, argChild, argBelongsTo
  if objectp(argChild) then
    child = argChild
  else
    child = me
  end if
  belongsTo = argBelongsTo
  className = #button
  ID = #none
  comment = EMPTY
  name = EMPTY
  Gfx = EMPTY
  Link = EMPTY
  ExecuteThis = EMPTY
  return me
end

on kill me
  _killed = 1
  if objectp(ancestor) then
    ancestor = ancestor.kill()
  end if
  child = 0
  belongsTo = 0
  return 0
end
