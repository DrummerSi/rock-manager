on xSetCursors
  startMember = 987
  numCursors = 0
  repeat with n = startMember to startMember + 1000
    memb = member(n, 2)
    if memb.type <> #cursor then
      numCursors = n - startMember
      exit repeat
    end if
  end repeat
  repeat with n = startMember to startMember + numCursors - 1
    cursMemb = member(n, 2)
    bmpMemb = member(n + numCursors, 2)
    cursMemb.castmemberlist = [bmpMemb]
    cursMemb.hotSpot = bmpMemb.regPoint + point(0, 3)
  end repeat
end
