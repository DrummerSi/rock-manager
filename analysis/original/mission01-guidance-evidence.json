  "missionStartTriggers": "[#TRMis1IntroducePublisher, #TRMis1IntroduceRehearsal, #TRMis1IntroduceCity, #TRMis1Succeeded, #TRLockUpPlacesFromRecord, #TRLockUpPlacesFromRecord01, #TRLockUpPlacesFromMixer01, #TRLockUpPlacesFromPublish, #TRLockUpPlacesFromRehearsal, #TRGeneralConcertStop, #TRGeneralExitToCity, #TRGeneralTourConcertStop, #TRNoInspiration, #TRGeneralCancelContract, #TRLockUpPlacesFromDesign, #TRMadCult, #TRReminderPressKit, #TRReminderVideo, #TRChartEnter, #TRChartExit, #TrChartNo1, #TRSignContract, #TRPublishAlreadyGotSong, #TRApproveDemo, #TRGeneralConcertStopMusicianMusicality]",
  "findings": {
    "sourcePolicy": "Retained decoded table expression strings are evidence only; never execute them.",
    "nativeExit": "Rehearsal ButtonOK checks assigned Vocals first, blocks closure with ECOCNeedSinger if vocalists remain. If unnamed and no changedBandName mission flag, sets flag, warns once and blocks that exit. At least one member is allowed; five members are not mandatory.",
    "keyboard": "Native Return routes through ButtonOK. Escape immediately exits key handler without closing any dialog; remake Escape convenience must retain exit guards.",
    "defaultBandName": "Translation.txt English szidUnnamedBand is The Unknowns. Legacy remake Unnamed band should migrate or recognize same warning.",
    "nativeChain": "City -> enter rehearsal -> guarded exit rehearsal -> publisher; leave publisher with >=1 song -> studio; enter mixer -> mixer; leave mixer -> label; exit label -> sleeve when signed, else NoContract; leave design with ReleaseDate>0 -> media; timer after1day -> charts; another day -> calendar.",
    "omittedEdges": "IntroduceVenue card is never emitted by native Mission01 trigger: similarly named trigger emits NoContract/Sleeve. IntroduceAdvance1/2 exist but no Mission01 StartTriggers activation of Advance1 was found. Helper deliberately exposes Venue after NoContract and Advance a day after first media exit as reconstruction repairs using original cards. TRPublishAlreadyGotSong deactivates after first publisher entry even when no song is owned; the reconstruction shows its retained card once when entering with an owned song, an explicit reminder repair.",
    "reminders": "Signed contract+10days without cover -> ECOCRecordTellDesign. AlbumRelease+10/+14/+16days with missing respective album presskits -> CityNews/Zer0/Radio request cards. Card ExecuteThis voices m03new005,m04new006,m02new004.",
    "success": "Mission01 starts TRMis1Succeeded: Record Store ChartEnter activates succeeded02; timer+1day then Mission.succeeded. ClassMediaScript emits ChartEnter on position<=10, confirming native Top10 goal with a one-day completion delay.",
    "persistentFlags": "Keep seenTutorials; persist acknowledgementDays to distinguish chart/calendardelays after reload; bandNameChanged or one-time ECOCForgetBandName seen flag approximates native changedBandName. Singer requirement remains mandatory when tutorials disabled.",
    "limitations": "General stochastic mission events, videos and advanced venues are retained evidence, not introduced as playable features by this helper."
  },
